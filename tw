def _fish_line(f):
    line = 'complete -c tw'
    if f.short:
        line += f' -s {f.short[1:]}'
    line += f' -l {f.long[2:]} -d "{f.help}"'
    words = _FISH_WORDS.get(f.complete)
    if words:
        line += f' -x -a "{words}"'
    elif f.kind == 'arg':
        line += ' -x'
    return line


def generate_fish_completion():
    """Generate fish completion script for tw"""
    lines = '\n'.join(_fish_line(f) for f in _completion_flags())
    topics = '\n'.join(f'    echo "{t}"' for t in HELP_TOPICS)
