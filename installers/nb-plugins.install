#!/usr/bin/env bash
# HANDCRAFTED (1.3.0: installs the plugins into nb, 1.3.1: updates them; make-awesome must not regenerate it)
set -euo pipefail

# ============================================================================
# nb-plugins - Installer Script
# Version: 1.3.1
# Hand-written since 1.3.0
# ============================================================================

VERSION="1.3.1"
APPNAME="nb-plugins"
BASE_URL="https://raw.githubusercontent.com/linuxcaffe/nb-plugins/main"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

tw_msg() { echo -e "${BLUE}[tw]${NC} $*"; }
tw_success() { echo -e "${GREEN}[tw] [OK]${NC} $*"; }
tw_error() { echo -e "${RED}[tw] [FAIL]${NC} $*" >&2; }

# Debug support
DEBUG_LEVEL="${TW_DEBUG:-0}"
debug_msg() {
    local msg="$1"
    local level="${2:-1}"
    if [[ $DEBUG_LEVEL -ge $level ]]; then
        echo -e "${BLUE}[DEBUG-$level]${NC} $msg" >&2
    fi
}

debug_msg "Starting installer with DEBUG_LEVEL=$DEBUG_LEVEL" 1

# Directories
HOME="${HOME:-$(eval echo ~$USER)}"
TASKRC="${TASKRC:-${HOME}/.taskrc}"
TASK_DIR="${TW_TASK_DIR:-${HOME}/.task}"
HOOKS_DIR="${TASK_DIR}/hooks"
SCRIPTS_DIR="${TASK_DIR}/scripts"
CONFIG_DIR="${TASK_DIR}/config"
DOCS_DIR="${TASK_DIR}/docs"
MAN_DIR="${DOCS_DIR}/man"

# ============================================================================
# Installation Function
# ============================================================================

install() {
    tw_msg "Installing nb-plugins v$VERSION..."
    debug_msg "Starting installation" 1

    # Create directories
    tw_msg "Creating directories..."
    mkdir -p "$HOOKS_DIR" "$SCRIPTS_DIR" "$CONFIG_DIR" "$DOCS_DIR"
    debug_msg "Directories created" 2

    tw_msg "Downloading files..."
    debug_msg "Using BASE_URL: $BASE_URL" 2

    tw_msg "Downloading documentation..."
    curl -fsSL "$BASE_URL/README.md" -o "$DOCS_DIR/nb-plugins_README.md" 2>/dev/null || true
    debug_msg "Downloaded doc: $DOCS_DIR/nb-plugins_README.md" 2

    # The plugins themselves (1.3.0: before, only this README was installed, so `tw -I nb-plugins`
    # gave you no plugin). Into nb's own plugins folder, by nb, when nb is here. One already there
    # is kept, a symlink into a dev repo too. Never fails the install: a plugin that won't
    # download is named, with its command.
    PLUGINS_DIR="${NB_DIR:-${HOME}/.nb}/.plugins"
    if command -v nb &>/dev/null; then
        for plugin in cal grep send tw; do
            url="$BASE_URL/${plugin}.nb-plugin"
            path="$PLUGINS_DIR/${plugin}.nb-plugin"
            if [[ -L "$path" && -e "$path" ]]; then
                tw_msg "nb-plugin ${plugin}: a link, left as it is"          # a dev checkout's
            elif [[ -f "$path" ]]; then
                # 1.3.1: an ordinary copy is brought up to date (the phone's had fallen behind)
                tmp="$(mktemp "${path}.XXXXXX")"
                if ! curl -fsSL "$url" -o "$tmp" 2>/dev/null || [[ ! -s "$tmp" ]]; then
                    rm -f "$tmp"
                    tw_msg "NOTE: couldn't check nb-plugin ${plugin} for an update (no network?): kept as it is"
                elif cmp -s "$tmp" "$path"; then
                    rm -f "$tmp"
                    tw_msg "nb-plugin ${plugin}: up to date"
                else
                    chmod --reference="$path" "$tmp" 2>/dev/null || chmod 755 "$tmp"
                    mv -f "$tmp" "$path"
                    tw_msg "Updated nb-plugin ${plugin}"
                fi
            else
                [[ -L "$path" ]] && rm -f "$path"                            # a dangling link
                if nb plugins install "$url" </dev/null >/dev/null 2>&1 && [[ -e "$path" ]]; then
                    tw_msg "Installed nb-plugin ${plugin}"
                else
                    tw_msg "NOTE: couldn't install nb-plugin ${plugin} (no network?): nb plugins install $url"
                fi
            fi
        done
    else
        tw_msg "NOTE: nb not found: no plugins installed. Once nb is here, run tw -I nb-plugins again"
    fi

    # Track in manifest
    debug_msg "Writing to manifest" 2
    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$(dirname "$MANIFEST_FILE")"

    echo "$APPNAME|$VERSION|$DOCS_DIR/nb-plugins_README.md||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $DOCS_DIR/nb-plugins_README.md" 3

    debug_msg "Installation complete" 1
    tw_success "Installed nb-plugins v$VERSION"
    echo ""
    tw_msg "Documentation: $DOCS_DIR/nb-plugins_README.md"
    echo ""

    return 0
}

# ============================================================================
# Removal Function
# ============================================================================

remove() {
    tw_msg "Removing nb-plugins..."
    debug_msg "Starting removal" 1

    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    if [ ! -f "$MANIFEST_FILE" ]; then
        tw_error "Manifest file not found"
        return 1
    fi

    # Remove files based on manifest
    grep "^$APPNAME|" "$MANIFEST_FILE" | cut -d"|" -f3 | while read -r file; do
        if [ -f "$file" ] || [ -L "$file" ]; then   # -L: a link, even dangling
            rm "$file"
            debug_msg "Removed: $file" 2
            tw_msg "Removed: $(basename $file)"
        fi
    done

    # Remove from manifest
    sed -i.bak "/^$APPNAME|/d" "$MANIFEST_FILE"
    debug_msg "Removed from manifest" 2

    tw_msg "nb's plugins are left in place: nb plugins uninstall <name> removes one"
    tw_success "Removed nb-plugins"
    return 0
}

# ============================================================================
# Main
# ============================================================================

case "${1:-install}" in
    install)
        install
        ;;
    remove|uninstall)
        remove
        ;;
    *)
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
