#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# smart-nag - Installer Script
# Version: 1.3.2
#
# HANDCRAFTED — do not overwrite with make-awesome.py --install
# Keeps the user's smart-nag.rc and the popup timer's enabled state across
# tw -u (a remove followed by an install), installs the systemd user units,
# includes nag-state.rc, the file nag writes nag= to, and registers the
# nag command as a tw wrapper keyword (tw nag).
# ============================================================================

VERSION="1.3.2"
APPNAME="smart-nag"
BASE_URL="https://raw.githubusercontent.com/linuxcaffe/tw-smart-nag-hook/master"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

tw_msg() { echo -e "${BLUE}[tw]${NC} $*"; }
tw_success() { echo -e "${GREEN}[tw] [OK]${NC} $*"; }
tw_error() { echo -e "${RED}[tw] [FAIL]${NC} $*" >&2; }

# Debug support
DEBUG_LEVEL="${TW_DEBUG:-0}"
debug_msg() {
    local msg="$1"
    local level="${2:-1}"
    if [[ $DEBUG_LEVEL -ge $level ]]; then
        echo -e "${BLUE}[DEBUG-$level]${NC} $msg" >&2
    fi
}

debug_msg "Starting installer with DEBUG_LEVEL=$DEBUG_LEVEL" 1

# Directories
HOME="${HOME:-$(eval echo ~$USER)}"
TASKRC="${HOME}/.taskrc"
TASK_DIR="${HOME}/.task"
HOOKS_DIR="${TASK_DIR}/hooks"
SCRIPTS_DIR="${TASK_DIR}/scripts"
CONFIG_DIR="${TASK_DIR}/config"
DOCS_DIR="${TASK_DIR}/docs"
SYSTEMD_DIR="${HOME}/.config/systemd/user"
MANIFEST_FILE="${CONFIG_DIR}/.tw_manifest"
INCLUDED_RC="${CONFIG_DIR}/included.rc"
NAG_STATE="${CONFIG_DIR}/nag-state.rc"
TIMER="tw-smart-nag-popup.timer"
# remove leaves this when the timer was enabled; install re-enables it and deletes it
TIMER_MARK="${CONFIG_DIR}/.smart-nag-timer-enabled"
WRAPPERS_FILE="${CONFIG_DIR}/.tw_wrappers"

fetch() {
    curl -fsSL "$BASE_URL/$1" -o "$2" || {
        tw_error "Failed to download $1"
        return 1
    }
    debug_msg "Installed: $2" 2
}

# Include a config file from included.rc (if present) or .taskrc, re-enabling an
# include tw -r commented out; never adds a second one
include_rc() {
    local name="$1"
    if grep -qE "^[[:space:]]*include[[:space:]].*${name}" "$TASKRC" "$INCLUDED_RC" 2>/dev/null; then
        tw_msg "Already included: $name"
    elif grep -qE "^[[:space:]]*#[[:space:]]*include[[:space:]].*${name}" "$INCLUDED_RC" 2>/dev/null; then
        sed -i.bak -E "s|^[[:space:]]*#[[:space:]]*(include[[:space:]].*${name})[[:space:]]*(#.*)?$|\1|" "$INCLUDED_RC"
        tw_msg "Re-enabled include in included.rc: $name"
    elif [ -f "$INCLUDED_RC" ]; then
        echo "include ${CONFIG_DIR}/${name}" >> "$INCLUDED_RC"
        tw_msg "Added include to included.rc: $name"
    else
        echo "include ${CONFIG_DIR}/${name}" >> "$TASKRC"
        tw_msg "Added include to .taskrc: $name"
    fi
}

# ============================================================================
# Installation Function
# ============================================================================

install() {
    tw_msg "Installing smart-nag v$VERSION..."

    mkdir -p "$HOOKS_DIR" "$SCRIPTS_DIR" "$CONFIG_DIR" "$DOCS_DIR" "$SYSTEMD_DIR"

    tw_msg "Downloading files..."
    fetch on-launch_smart-nag.py "$HOOKS_DIR/on-launch_smart-nag.py"
    chmod +x "$HOOKS_DIR/on-launch_smart-nag.py"
    fetch nag "$SCRIPTS_DIR/nag"
    chmod +x "$SCRIPTS_DIR/nag"
    fetch tw-smart-nag-popup.service "$SYSTEMD_DIR/tw-smart-nag-popup.service"
    fetch "$TIMER" "$SYSTEMD_DIR/$TIMER"

    # Config — only written if not already present (the user's settings survive tw -u)
    if [ -f "$CONFIG_DIR/smart-nag.rc" ]; then
        tw_msg "Config already exists, not overwriting: $CONFIG_DIR/smart-nag.rc"
    else
        fetch smart-nag.rc "$CONFIG_DIR/smart-nag.rc"
    fi

    # The hook writes nag= here; Taskwarrior shows it only if it's included
    [ -f "$NAG_STATE" ] || echo "nag=" > "$NAG_STATE"
    include_rc nag-state.rc
    include_rc smart-nag.rc

    curl -fsSL "$BASE_URL/README.md" -o "$DOCS_DIR/smart-nag_README.md" 2>/dev/null || true

    if ! grep -q "^nag|" "$WRAPPERS_FILE" 2>/dev/null; then
        echo "nag|nag|smart-nag: the nag on demand (nag), why it was chosen (nag -l), edit its conditions (nag -e)|command" >> "$WRAPPERS_FILE"
        tw_msg "Registered wrapper: nag -> nag (command)"
    fi

    if command -v systemctl &>/dev/null; then
        systemctl --user daemon-reload 2>/dev/null || true
        if [ -f "$TIMER_MARK" ]; then
            systemctl --user enable --now "$TIMER" 2>/dev/null || true
            rm -f "$TIMER_MARK"
            tw_msg "Re-enabled $TIMER"
        fi
    fi

    # Track in manifest (smart-nag.rc is listed, but remove keeps it)
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    for file in "$HOOKS_DIR/on-launch_smart-nag.py" "$SCRIPTS_DIR/nag" \
                "$SYSTEMD_DIR/tw-smart-nag-popup.service" "$SYSTEMD_DIR/$TIMER" \
                "$CONFIG_DIR/smart-nag.rc" "$NAG_STATE" "$DOCS_DIR/smart-nag_README.md"; do
        echo "$APPNAME|$VERSION|$file||$TIMESTAMP" >> "$MANIFEST_FILE"
    done

    tw_success "Installed smart-nag v$VERSION"
    echo ""
    tw_msg "Try: nag -l   (the conditions, and which one wins)"
    tw_msg "Desktop popups (optional): set nag.popup = on in ~/.task/config/smart-nag.rc, then"
    tw_msg "  systemctl --user enable --now $TIMER"
    tw_msg "Documentation: $DOCS_DIR/smart-nag_README.md"
    echo ""

    return 0
}

# ============================================================================
# Removal Function
# ============================================================================

remove() {
    tw_msg "Removing smart-nag..."

    if [ ! -f "$MANIFEST_FILE" ]; then
        tw_error "Manifest file not found"
        return 1
    fi

    # Stop the popup timer; remember it was on, so tw -u's install turns it back on
    if command -v systemctl &>/dev/null; then
        if systemctl --user is-enabled "$TIMER" &>/dev/null; then
            touch "$TIMER_MARK"
            systemctl --user disable --now "$TIMER" 2>/dev/null || true
        fi
    fi

    # Remove files listed in manifest, except the settings (kept, as install keeps them).
    # nag-state.rc goes, so tw comments out its include and no stale nag is shown.
    grep "^$APPNAME|" "$MANIFEST_FILE" | cut -d"|" -f3 | while read -r file; do
        [[ "$file" == "$CONFIG_DIR/smart-nag.rc" ]] && continue
        if [ -f "$file" ]; then
            rm "$file"
            debug_msg "Removed: $file" 2
            tw_msg "Removed: $(basename "$file")"
        fi
    done
    if command -v systemctl &>/dev/null; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$TASK_DIR/logs/smart-nag.cache"

    if grep -q "^nag|" "$WRAPPERS_FILE" 2>/dev/null; then
        sed -i.bak "/^nag|/d" "$WRAPPERS_FILE"
        tw_msg "Unregistered wrapper: nag"
    fi

    tw_msg "Config preserved: $CONFIG_DIR/smart-nag.rc"

    sed -i.bak "/^$APPNAME|/d" "$MANIFEST_FILE"

    tw_success "Removed smart-nag"
    return 0
}

# ============================================================================
# Main
# ============================================================================

case "${1:-install}" in
    install)
        install
        ;;
    remove|uninstall)
        remove
        ;;
    *)
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
