class TaskRC:
    """Fast .taskrc reader/writer — no subprocesses.
    
    Reads ~/.taskrc and follows include directives recursively so that
    context definitions in tod.rc, recurrence.rc, etc. are all visible.
    
    Writes go ONLY to ~/.taskrc (the primary file). Keys defined in
    included files are readable but not written there.
    
    Usage:
        rc = TaskRC()
        val = rc.get('context')               # instant, no subprocess
        val = rc.get('context.work.read')     # works across includes
        rc.set_keys({'context': 'cmx:work,home',
                     'cmx.contexts': 'work,home',
                     'context.cmx.read': '( +work ) and ( +home )'})
    """
    
    def __init__(self):
        # The rc file task itself reads: $TASKRC, else ~/.taskrc
        self.TASKRC_PATH = Path(os.environ.get('TASKRC') or Path.home() / '.taskrc').expanduser()
        self._data = {}          # key -> value, all files merged
        self._primary_lines = [] # raw lines from the primary file only (for writing)
        self._seen = set()       # files already read: a circular include is read once
        self._loaded = False
    
    def _load(self):
        if self._loaded:
            return
        self._loaded = True
        self._primary_lines = self._read_file(self.TASKRC_PATH, primary=True)
    
    def _read_file(self, path, primary=False):
        """Read one rc file, following includes as task does (_include_target), each file once.
        Returns raw lines if primary=True."""
        lines = []
        try:
            real = Path(path).resolve()
            if real in self._seen:
                return lines
            self._seen.add(real)
            with open(path, 'r') as f:
                raw = f.readlines()
        except OSError:
            return lines
        
        if primary:
            lines = raw  # preserve for later writing
        
        for line in raw:
            stripped = line.strip()
            if not stripped or stripped.startswith('#'):
                continue
            
            # Follow include directives
            m = _INCLUDE_RE.match(stripped)
            if m:
                target = _include_target(m.group(2), Path(path))
                if target:
                    self._read_file(target, primary=False)
                continue
            
            # Parse key=value
            if '=' in stripped:
                key, _, value = stripped.partition('=')
                key = key.strip()
                value = value.strip()
                # Last definition wins (taskwarrior behaviour)
                self._data[key] = value
        
        return lines
    
    def get(self, key, default=''):
        """Return value for key, or default if not found."""
        self._load()
        return self._data.get(key, default)
    
    def set_keys(self, updates: dict, drop=None):
        """Write multiple key=value pairs to the primary rc file in one pass.
        
        - Existing keys are updated in-place (preserving line order/comments).
        - New keys are appended at the end.
        - Empty-string values blank the value but keep the line (key=).
        - drop(key) → True removes that key's line (keys in updates are never dropped).
        - A symlinked rc file stays a symlink: the file it points to is rewritten.
        """
        self._load()
        
        remaining = dict(updates)  # keys still to handle
        new_lines = []
        dropped = []
        
        for line in self._primary_lines:
            stripped = line.strip()
            if stripped and not stripped.startswith('#') and '=' in stripped:
                key = stripped.partition('=')[0].strip()
                if drop and key not in updates and drop(key):
                    dropped.append(key)
                    continue
                if key in remaining:
                    # Replace this line
                    new_lines.append(f"{key}={remaining.pop(key)}\n")
                    continue
            new_lines.append(line)
        
        # Append any keys that weren't already in the file
        for key, value in remaining.items():
            new_lines.append(f"{key}={value}\n")
        
        # Write atomically via a temp file next to the real file (through a symlink, not over it)
        target = self.TASKRC_PATH.resolve()
        tmp = target.with_name(target.name + '.tw.tmp')
        try:
            with open(tmp, 'w') as f:
                f.writelines(new_lines)
            try:
                shutil.copymode(target, tmp)
            except OSError:
                pass
            tmp.replace(target)
            # Update in-memory state
            self._primary_lines = new_lines
            self._data.update(updates)
            for key in dropped:
                self._data.pop(key, None)
        except OSError as e:
            print(f"[tw] Error writing .taskrc: {e}", file=sys.stderr)
            tmp.unlink(missing_ok=True)
            raise


class Flag(NamedTuple):
    """One of tw's own flags. kind says what argument it takes:
        flag  none                                  arg   the next word
        opt   the next word, unless that is a flag or a +/-tag (`tw -i`, `tw -i APP`)
        eq    a value only as --flag=VALUE (`--debug=2`)
        many  the following words (hidden --gen, after -g)
    param is what the help shows after it; complete is what its argument completes to (apps,
    installed, topics, shells, ids, levels); passthrough means task's words follow it, so the
    shell completions keep offering them; hidden flags are only for another flag's use."""
    short: str
    long: str
    kind: str
    help: str
    param: str = ''
    complete: str = None
    passthrough: bool = False
    hidden: bool = False


# tw's flags: this table drives the argument split, argparse, `tw -h` and the bash/zsh/fish
# completions. A wrapper keyword never dispatches after one of these, except the prefix flags,
