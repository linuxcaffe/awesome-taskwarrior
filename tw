    Flag('-l', '--list',                'flag', 'List installed/available applications', '[+/-tags]'),
    Flag('-p', '--pager',               'flag', 'Use pager for task output', '[cmd]', passthrough=True),
    Flag('-R', '--readme',              'opt',  'List docs or open README for app', '[APP]'),
    Flag('-r', '--remove',              'arg',  'Remove an application', 'APP', 'installed'),
    Flag('-s', '--shell',               'flag', 'Start interactive shell', '[cmd]',
