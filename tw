COMPLETIONS = {
    'bash': generate_bash_completion,
    'zsh':  generate_zsh_completion,
    'fish': generate_fish_completion,
}

def install_completion(shell):
    """Install completion script for the specified shell"""
    shell = shell.lower()
    home = Path.home()
    
    # Determine target path and script content
    if shell == 'bash':
        target_dir = home / '.bash_completion.d'
        target_file = target_dir / 'tw.sh'
        script_content = COMPLETIONS[shell]()
        source_line = f'source {target_file}'
        rc_file = home / '.bashrc'
    elif shell == 'zsh':
        target_dir = home / '.zsh' / 'completion'
        target_file = target_dir / '_tw'
        script_content = COMPLETIONS[shell]()
        source_line = None  # zsh uses fpath, handled differently
        rc_file = home / '.zshrc'
    elif shell == 'fish':
        target_dir = home / '.config' / 'fish' / 'completions'
        target_file = target_dir / 'tw.fish'
        script_content = COMPLETIONS[shell]()
        source_line = None  # fish auto-loads completions
        rc_file = None
    else:
        return (False, f"Unknown shell type '{shell}'")
    
    try:
        # Create directory if it doesn't exist
        target_dir.mkdir(parents=True, exist_ok=True)
        
        # Write completion script
        target_file.write_text(script_content)
        print(f"[tw] Wrote completion script to: {target_file}")
        
        # Shell-specific setup
        if shell == 'bash':
            # Check if already sourced in .bashrc
            if rc_file.exists():
                rc_content = rc_file.read_text()
                if source_line not in rc_content:
                    print(f"[tw] Add this line to {rc_file}:")
                    print(f"[tw]   {source_line}")
                else:
                    print(f"[tw] Already configured in {rc_file}")
            else:
                print(f"[tw] Add this line to {rc_file}:")
                print(f"[tw]   {source_line}")
            
            print(f"[tw] To activate now: source {target_file}")
            
        elif shell == 'zsh':
            # Check fpath configuration
            if rc_file.exists():
                rc_content = rc_file.read_text()
                fpath_line = f'fpath=({target_dir} $fpath)'
                compinit_line = 'autoload -Uz compinit && compinit'
                
                needs_fpath = str(target_dir) not in rc_content and 'fpath=' not in rc_content
                needs_compinit = 'compinit' not in rc_content
                
                if needs_fpath or needs_compinit:
                    print(f"[tw] Add these lines to {rc_file}:")
                    if needs_fpath:
                        print(f"[tw]   {fpath_line}")
                    if needs_compinit:
                        print(f"[tw]   {compinit_line}")
                else:
                    print(f"[tw] Completion path already configured in {rc_file}")
            else:
                print(f"[tw] Add these lines to {rc_file}:")
                print(f"[tw]   fpath=({target_dir} $fpath)")
                print(f"[tw]   autoload -Uz compinit && compinit")
            
            print(f"[tw] To activate now: exec zsh")
            
        elif shell == 'fish':
            print(f"[tw] Fish will auto-load completions on next shell start")
            print(f"[tw] To activate now: exec fish")
        
        return (True, None)
        
    except Exception as e:
        return (False, f"Failed to install completion: {e}")

def readme_cmd(docs_dir, query):
    """List or open README/doc files from ~/.task/docs/.

    tw -R          — list all doc files
    tw -R <query>  — open first file whose name contains query (case-insensitive)
    """
    docs_dir = Path(docs_dir)
    if not docs_dir.exists():
        print(f"[tw] No docs directory: {docs_dir}")
        return 1

    # Collect all files (README.md, *_README.md, *.md, *.txt)
    docs = sorted(
        [f for f in docs_dir.rglob('*') if f.is_file() and f.suffix in ('.md', '.txt', '.rst')],
        key=lambda f: f.name.lower()
    )

    if not docs:
        print(f"[tw] No docs found in {docs_dir}")
        return 0

    if not query:
        # List mode
        print(f"[tw] Docs in {docs_dir}:")
        for f in docs:
            rel = f.relative_to(docs_dir)
            # Strip leading path to show cleanly
            app = str(rel).replace('_README.md', '').replace('README.md', '').replace('.md', '').replace('/', ' / ')
            print(f"  {app:35s}  {rel}")
        return 0

    # Open mode — match priority: exact appname > prefix > substring
    q = query.lower()

    def appname(f):
        return f.name.lower().replace('_readme.md', '').replace('readme.md', '').replace('.md', '').replace('.txt', '').replace('.rst', '')

    exact    = [f for f in docs if appname(f) == q]
    prefix   = [f for f in docs if appname(f).startswith(q) and f not in exact]
    substr   = [f for f in docs if q in appname(f) and f not in exact and f not in prefix]
    matches  = exact or prefix or substr

    if not matches:
        print(f"[tw] No doc matching '{query}' in {docs_dir}")
        print(f"[tw] Try: tw -R  (to list all)")
        return 1

    target = matches[0]
    if len(matches) > 1:
        print(f"[tw] Multiple matches — opening first: {target.name}")

    viewer = _md_viewer()
    os.execvp(viewer[0], viewer + [str(target)])


def _md_viewer():
    """argv for showing a markdown file: bat (Debian/Ubuntu name it batcat) > $PAGER > less > cat.
    A `bat` must say it's bat: on Ubuntu it can be Bacula's console, which opens a Qt app."""
    for name in ('batcat', 'bat'):
        if shutil.which(name):
            try:
                out = subprocess.run([name, '--version'], capture_output=True, text=True, timeout=5).stdout
            except (OSError, subprocess.TimeoutExpired):
                continue
            if out.startswith('bat '):
                return [name, '--style=plain', '--language=md']
    for pager in (os.environ.get('PAGER'), 'less'):
        if pager and shutil.which(pager.split()[0]):
            return pager.split()
    return ['cat']


