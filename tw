def _app_matches(registry, app_name, tag_filter):
    """Does the app's registry entry match the tag filter? None when there's no entry. Asks the
    registry (local in dev mode, GitHub otherwise): registry_dir is None outside dev mode."""
    meta = registry.get_meta(app_name)
    if not meta:
        return None
    return tag_filter.matches(meta.get_tags())


# How argparse takes each kind of flag (help=SUPPRESS: tw prints its own help)
_ARGPARSE_KIND = {
    'flag': lambda f: dict(action='store_true', help=argparse.SUPPRESS),
    'arg':  lambda f: dict(metavar=f.param.strip('[]') or None, help=argparse.SUPPRESS),
    'opt':  lambda f: dict(nargs='?', const='', metavar=f.param.strip('[]') or None,
                           help=argparse.SUPPRESS),
    'eq':   lambda f: dict(nargs='?', const='1', help=argparse.SUPPRESS),
    'many': lambda f: dict(nargs='*', help=argparse.SUPPRESS),
}


def build_parser():
    """argparse for tw's leading flags, from TW_FLAGS."""
    parser = argparse.ArgumentParser(prog='tw', add_help=False,
                                     description='awesome-taskwarrior package manager and wrapper')
    for f in TW_FLAGS:
        parser.add_argument(*_flag_names(f), **_ARGPARSE_KIND[f.kind](f))
    return parser


def _split_tw_args(argv):
    """(argparse's args, the rest). argparse sees only tw's own leading flags (and the argument a
    flag takes); from the first word that isn't one of them, everything passes through. A dash
    word that isn't a tw flag (`-hook` in `tw -l -hook`, `-tag` in `tw -p -tag next`) is an
    excluded tag or task's own, never a cluster of short flags. A tw flag never becomes another
    flag's argument: `tw --install --dry-run APP` is `--dry-run --install APP`."""
    flags_with_args = {n for f in TW_FLAGS if f.kind in ('arg', 'opt') for n in _flag_names(f)}
    optional_arg = {n for f in TW_FLAGS if f.kind == 'opt' for n in _flag_names(f)}  # `tw -i +tag`
    parser_args, rest = [], []
    waiting = None          # index in parser_args of a flag still waiting for its argument
    for i, arg in enumerate(argv):
        is_flag = _is_tw_flag(arg) or arg.split('=')[0] in TW_HIDDEN_FLAGS
        if (waiting is not None and not is_flag and parser_args[waiting] in optional_arg
                and arg.startswith(('+', '-'))):
            rest = list(argv[i:])
            break
        if waiting is not None and not is_flag:
            parser_args.append(arg)
            waiting = None
        elif is_flag:
            if waiting is not None:
                parser_args.insert(waiting, arg)    # goes in front, so the argument still follows
                waiting += 1
            else:
                parser_args.append(arg)
                if arg.split('=')[0] in flags_with_args and '=' not in arg:
                    waiting = len(parser_args) - 1
        else:
            rest = list(argv[i:])
            break
    return parser_args, rest


def validate_first_arg_flag(args):
    """Is the first argument one of tw's flags? Returns (is_tw_flag, error_message).

    A flag counts only as a whole word (`-lena` is not `-l`). A first word that isn't a tw flag
    is task's: `-home` excludes a tag, `--` ends the filter. Only a word shaped like a mistyped
    flag is an error: one letter (`-x`) or a double dash (`--isntall`)."""
    if not args or not args[0].startswith('-'):
        return (False, None)
    first_arg = args[0]
    if _is_tw_flag(first_arg):
        return (True, None)
    if first_arg == '--' or re.fullmatch(r'-[^-].+', first_arg):
        return (False, None)                # task's own: a tag exclusion, or --
    return (False, f"Unknown flag: {first_arg}")

# The dot shortcuts: (label, status, newest by, what to return)
DOT_SHORTCUTS = {
    '.':    ('most recently added task',     'pending',   'entry',    'id'),
    '..':   ('most recently modified task',  'pending',   'modified', 'id'),
    '...':  ('most recently completed task', 'completed', 'end',      'uuid'),
    '....': ('most recently deleted task',   'deleted',   'end',      'uuid'),
}


def resolve_dot_shortcut(dot, debug_wrapper=False):
    """The task a dot shortcut means: an ID for a pending task, the short (8-char) UUID for a
    completed or deleted one (they have no ID). Ignores the active context. Notices go to stderr,
    so `tw . export` stays clean. Returns the ID/UUID string, or None."""
    if dot not in DOT_SHORTCUTS:
        print(f"[tw] [X] Unknown dot-shortcut: {dot}", file=sys.stderr)
        return None
    label, status, newest_by, want = DOT_SHORTCUTS[dot]
    if debug_wrapper:
        print(f"[tw-debug] Resolving {dot} -> {label}", file=sys.stderr)
    r = run_task(['rc.context:none', 'rc.verbose:nothing', 'rc.hooks:off', f'status:{status}', 'export'],
                 capture_output=True, text=True)
    try:
        tasks = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []
    except ValueError as e:
        if debug_wrapper:
            print(f"[tw-debug] Error resolving {dot}: {e}", file=sys.stderr)
        tasks = []
    tasks = [t for t in tasks if t.get(want) and t.get(newest_by)]
    if not tasks:
        print(f"[tw] [X] No {label} found", file=sys.stderr)
        return None
    found = max(tasks, key=lambda t: t[newest_by])
    result = str(found['id']) if want == 'id' else found['uuid'][:8]
    print(f"[tw] {dot} -> task {result}", file=sys.stderr)
    return result


class Cmx:
    """Context multiplexing: several contexts at once, their filters joined with `and`.

    All state lives in the taskrc (read and written through one TaskRC, no subprocesses):
        context=cmx:<a,b>                the active context, named after the set, so task's
                                         own messages say "Context 'cmx:a,b' applied."
        context.cmx:<a,b>.read/.write    the combined filter, where task looks for it
        context.cmx.read/.write          the same, for tw and other readers
        cmx.contexts=a,b                 the set; kept while paused (@0) so @@ restores it
    A set of one is just a regular context (context=<name>, no cmx keys).
    """

    CLEARED = {'cmx.contexts': '', 'context.cmx.read': '', 'context.cmx.write': ''}

    def __init__(self, rc=None):
        self.rc = rc or TaskRC()

    @staticmethod
    def is_set_key(key):
        """context.cmx:<set>.read/.write: one per set ever activated, unless dropped."""
        return key.startswith('context.cmx:')

    @property
    def active(self):
        """Is a cmx set the active context (not paused or cleared)?"""
        ctx = self.rc.get('context')
        return ctx == 'cmx' or ctx.startswith('cmx:')

    @property
    def saved(self):
        """The set in cmx.contexts, active or paused."""
        return [c.strip() for c in self.rc.get('cmx.contexts').split(',') if c.strip()]

    @property
    def current(self):
        """The active set ([] when cmx is paused or off)."""
        return self.saved if self.active else []

    def filter(self, name, kind='read'):
        """A context's read or write filter; the read filter falls back to the pre-2.6 single key
        (context.<name>=filter). '' when it isn't defined."""
        f = self.rc.get(f'context.{name}.{kind}')
        if not f and kind == 'read':
            f = self.rc.get(f'context.{name}')
        return f

    def defined(self, name):
        return bool(self.filter(name))

    def combined(self, names, kind='read'):
        return ' and '.join(f'( {f} )' for f in (self.filter(n, kind) for n in names) if f)

    def _write(self, updates):
        self.rc.set_keys(updates, drop=self.is_set_key)     # earlier sets' context.cmx:<set>.* go

    def activate(self, names, silent=False):
        """Make names the active set (no names: clear every context). 0, or 1 when one isn't defined."""
        if not names:
            self._write({'context': '', **self.CLEARED})
            if not silent:
                print("Cleared all contexts")
            return 0
        for name in names:
            if not self.defined(name):
                if not silent:
                    self._undefined(name)
                return 1
        joined = ','.join(names)
        read, write = self.combined(names, 'read'), self.combined(names, 'write')
        updates = {'context': f'cmx:{joined}', 'cmx.contexts': joined}
        if read:
            updates[f'context.cmx:{joined}.read'] = updates['context.cmx.read'] = read
        if write:
            updates[f'context.cmx:{joined}.write'] = updates['context.cmx.write'] = write
        self._write(updates)
        if not silent:
            print(f"Activated contexts: {joined}")
            if read:
                print(f"Combined filter: {read}")
        return 0

    def use(self, name):
        """One regular context instead of a set."""
        self._write({'context': name, **self.CLEARED})
        print(f"Context: {name}")
        return 0

    def add(self, name):
        """@+: add a context to the active set. An active regular context joins the set with it;
        with no context active, it simply becomes the context."""
        if not self.defined(name):
            self._undefined(name)
            return 1
        current = self.current
        if not current:
            active = self.rc.get('context')
            if not active or self.active or not self.defined(active):
                self.rc.set_keys({'context': name})
                print(f"Context: {name}")
                return 0
            current = [active]                      # promote the regular context into a set
        if name in current:
            print(f"Context '{name}' is already active")
            return 0
        return self.activate(current + [name])

    def remove(self, name):
        """@-: take a context out of the active set; one left becomes a regular context."""
        current = self.current
        if not current:
            print("No cmx contexts are currently active")
            return 0
        if name not in current:
            print(f"Context '{name}' is not in the active set")
            return 0
        rest = [c for c in current if c != name]
        if len(rest) == 1:
            return self.use(rest[0])
        return self.activate(rest)

    def pause(self):
        """@0: no context, but the set stays in cmx.contexts for @@."""
        saved = self.rc.get('cmx.contexts')
        self._write({'context': '', 'context.cmx.read': '', 'context.cmx.write': ''})
        if saved:
            print(f"[tw] Context cleared  (CMX set preserved: {saved} — restore with 'tw @@')")
        else:
            print("[tw] Context cleared")
        return 0

    def restore(self):
        """@@: activate the saved set again, its filters rebuilt from the current definitions."""
        if not self.saved:
            print("[tw] No saved CMX set to restore  (use '@+ <context>' to build one)")
            return 1
        return self.activate(self.saved)

    def show(self):
        """@ alone: the active set and its filter, else task's own `context` output."""
        if self.saved and self.active:
            print(f"Context multiplexing active: {self.rc.get('cmx.contexts')}")
            if self.rc.get('context.cmx.read'):
                print(f"Combined filter: {self.rc.get('context.cmx.read')}")
            return 0
        return run_task(['context']).returncode

    def rebuild_if_stale(self):
        """Rebuild the active set's filters when CMX_STALE_MARKER exists, then remove the marker.
        Called at every start: without the marker it is one Path.exists(). Producer convention:
        an app that changes a context definition touches ~/.task/config/.cmx_stale."""
        if not CMX_STALE_MARKER.exists():
            return
        if self.active and self.saved:      # paused or off: @@ rebuilds when it comes back
            try:
                self.activate(self.saved, silent=True)
            except Exception:
                pass                        # never break normal tw operation over a rebuild
            debug(f"cmx rebuilt from stale marker: {self.saved}", 1)
        CMX_STALE_MARKER.unlink(missing_ok=True)

    @staticmethod
    def _undefined(name):
        print(f"[tw] Error: Context '{name}' is not defined")
        print(f"[tw] Use 'task context define {name} <filter>' to define it first")


def handle_context_command(word, rest, debug_wrapper=False):
    """tw's @ forms (word is the first argument, rest what follows it):
        @              show the context / active cmx set     @ <args>   task context <args>
        @+ <name>      add to the cmx set (@+name too)        @- <name>  remove from it (@-name)
        @0             pause: no context, set kept            @@         restore the set
        @: <name> ...  one command in that context            @_ ...     one command in none
        @?             task context show                      @<name>    task context <name>
    """
    if debug_wrapper:
        print(f"[tw-debug] Context command: {word} {rest}", file=sys.stderr)
    cmx = Cmx()
    if word == '@':
        if not rest:
            return cmx.show()
        if not rest[0].startswith(('+', '-')):
            return run_task(['context'] + rest).returncode     # `@ list`, `@ work`, `@ none`
        word, rest = '@' + rest[0], rest[1:]                    # `@ +work` is `@+work`
    try:
        return _context_op(cmx, word, rest)
    except OSError:
        return 1                    # TaskRC.set_keys has said what went wrong


def _context_op(cmx, word, rest):
    if word == '@0':
        return cmx.pause()
    if word == '@@':
        return cmx.restore()
    if word == '@?':
        return run_task(['context', 'show']).returncode
    if word == '@_':
        return run_task(['rc.context:none'] + rest).returncode
    if word == '@:':
        if not rest:
            print("[tw] Error: @: requires a context name")
            print("[tw] Usage: tw @: contextname [task args]")
            return 1
        return run_task([f'rc.context:{rest[0]}'] + rest[1:]).returncode
    if word in ('@+', '@-'):
        if not rest:
            print(f"[tw] Error: {word} requires a context name")
            return 1
        word, rest = word + rest[0], rest[1:]
    if word.startswith('@+'):
        return cmx.add(word[2:])
    if word.startswith('@-'):
        return cmx.remove(word[2:])
    return run_task(['context', word[1:]] + rest).returncode


def attach_file_to_task(task_id):
    """Attach a file to a task using ranger file browser"""
    try:
        # Check if ranger is installed
        ranger_bin = shutil.which('ranger')
        if not ranger_bin:
            print("[tw] Error: ranger is not installed")
            print("[tw] Install ranger to use file attachment feature")
            print("[tw] Debian/Ubuntu: sudo apt install ranger")
            print("[tw] Arch: sudo pacman -S ranger")
            print("[tw] macOS: brew install ranger")
            return 1
        
        # Get task description
        result = run_task([task_id, 'info'], capture_output=True, text=True)
        
        if result.returncode != 0:
            print(f"[tw] Error: Could not find task {task_id}")
            return 1
        
        # Extract description from info output
        desc = ""
        for line in result.stdout.split('\n'):
            if line.startswith('Description'):
                # Extract everything after "Description"
                desc = line.split(None, 1)[1] if len(line.split(None, 1)) > 1 else ""
                break
        
        print(f"[tw] Attaching to task {task_id}: '{desc}'")
        
        # Prompt for label
        print("[tw] Type a label (or press Enter for none): ", end='', flush=True)
        label = input().strip()
        
        # Create temp file for ranger output
        temp_file = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.ranger')
        temp_filename = temp_file.name
        temp_file.close()
        
        # Launch ranger
        print("[tw] Launching ranger... (press 'q' to cancel)")
        ranger_result = subprocess.run(
            [ranger_bin, f'--choosefile={temp_filename}'],
            check=False
        )
        
        # Read selected file
        try:
            with open(temp_filename, 'r') as f:
                selected_file = f.read().strip()
        except:
            selected_file = ""
        finally:
            os.unlink(temp_filename)
        
        if not selected_file:
            print("[tw] No file selected, attachment cancelled")
            return 0
        
        # Build annotation
        annotation = f"{label}: {selected_file}" if label else selected_file
        
        # Add annotation to task
        result = run_task([task_id, 'annotate', '--', annotation])
        
        if result.returncode == 0:
            print(f"[tw] + Attached: {annotation}")
        
        return result.returncode
        
    except KeyboardInterrupt:
        print("\n[tw] Attachment cancelled")
        return 1
    except Exception as e:
        print(f"[tw] Error attaching file: {e}", file=sys.stderr)
        return 1

def run_with_pager(task_args):
    """`task ARGS | less -R -X`, with colour forced, the terminal's width, and the reports' limits
    lifted. task's stderr is dropped (its notices would land in the pager). Returns the pager's
    exit code; without less or more, runs task plainly."""
    pager = shutil.which('less') or shutil.which('more')
    exe = shutil.which('task')
    if not pager or not exe:
        return pass_through_to_task(task_args)
    cols = shutil.get_terminal_size().columns
    # Some reports use 'limit', some 'lines' (next uses lines)
    overrides = ['rc._forcecolor=on', f'rc.defaultwidth={cols}', 'rc.limit=0',
                 'rc.report.next.limit=0', 'rc.report.next.lines=0', 'rc.report.list.limit=0',
                 'rc.report.all.limit=0', 'rc.report.ls.limit=0']
    argv = ['task'] + list(task_args) + overrides
    if os.environ.get('TW_DEBUG_WRAPPER', '0') != '0':
        print(f"[tw-debug] Pager pipeline: {shlex.join(argv)} 2>/dev/null | {pager} -R -X",
              file=sys.stderr)
    try:
        task = subprocess.Popen(argv, executable=exe, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL)
        rc = subprocess.run([pager, '-R', '-X'], stdin=task.stdout, check=False).returncode
        task.stdout.close()
        task.wait()
        return rc
    except KeyboardInterrupt:
        return 130
    except OSError as e:
        print(f"[tw] Error using pager: {e}", file=sys.stderr)
        return pass_through_to_task(task_args)


def _task_vocab():
    """What command_of needs from the taskrc: report names, aliases, abbreviation.minimum and
    default.command, from one read-only `task _show` (about 20 ms). None when task can't run."""
    try:
        r = run_task(['rc.hooks=off', 'rc.verbose=nothing', '_show'],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    vocab = {'reports': set(), 'aliases': {}, 'abbreviation': 2, 'default': 'next'}
    for line in r.stdout.splitlines():
        key, _, value = line.partition('=')
        m = re.fullmatch(r'report\.(.+)\.columns', key)
        if m:
            vocab['reports'].add(m.group(1))
        elif key.startswith('alias.'):
            vocab['aliases'][key[len('alias.'):]] = value
        elif key == 'abbreviation.minimum':
            try:
                vocab['abbreviation'] = int(value)
            except ValueError:
                pass
        elif key == 'default.command':
            vocab['default'] = value
    return vocab


_ID_RE = re.compile(r'[0-9][0-9,\-]*|[0-9a-f]{8}(-[0-9a-f]{1,12})*')


def _classify(args, vocab, depth=0):
    """(kind, name) of the command task would run for args: kind 'report' or 'other', name the
    command with abbreviation and alias resolved. Ambiguous: ('other', None). IDs alone mean
    information. (None, None) when there is no command (task then runs default.command)."""
    names = TASK_COMMANDS | vocab['reports'] | set(vocab['aliases'])
    ids = False
    for arg in args:
        if arg == '--':
            break                                   # the rest is text
        if arg.startswith(('rc.', 'rc:', '+', '-')) or ':' in arg:
            continue                                # overrides, tags, attributes
        if _ID_RE.fullmatch(arg):
            ids = True
            continue
        if not re.fullmatch(r'[a-z_][a-z0-9._]*', arg):
            continue
        if arg in names:
            name = arg
        else:
            matches = [n for n in names if n.startswith(arg)] if len(arg) >= vocab['abbreviation'] else []
            if len(matches) > 1:
                return 'other', None                # ambiguous: task refuses it, never a report
            if not matches:
                continue                            # a filter word
            name = matches[0]
        if name in vocab['aliases'] and depth < 5:
            try:
                return _classify(shlex.split(vocab['aliases'][name]), vocab, depth + 1)
            except ValueError:
                return 'other', None
        return ('report' if name in vocab['reports'] else 'other'), name
    return ('other', 'information') if ids else (None, None)


def command_of(args, vocab):
    """(kind, name) of what task runs for args, default.command included: ('report', 'next') for
    a bare `tw`, ('other', 'delete') for `tw 5 del`. (None, None) with no vocab (task can't run)."""
    if not vocab:
        return None, None
    kind, name = _classify(args, vocab)
    if kind is None:
        try:
            kind, name = _classify(shlex.split(vocab['default']), vocab)
        except ValueError:
            kind, name = None, None
    return kind, name


def _args_have_report(args, vocab):
    """True when task would run a report for args: the only case where filter wrappers (which
    reformat a report's dates) should see the output. Anything else (a write, information,
    an unknown or ambiguous command) runs plainly, so its prompts reach the terminal and its
    dates are parsed in the user's own dateformat. With no vocab (task can't run): False."""
    return command_of(args, vocab)[0] == 'report'


def run_with_timing(args):
    """Run task command with rc.debug.hooks=1 and TW_TIMING=1.

    Sets TW_TIMING=1 in the subprocess environment so that hooks
    instrumented by make-awesome.py --timing self-report their elapsed
    time on stderr as:
        [timing] hook-name.py: 12.3ms

    Also enables rc.debug.hooks=1 so task emits Hook:/Perf lines on
    stderr for aggregate breakdown.  Both data streams are parsed and
    rendered in a unified timing report.

    Returns exit code of the task process.
    """
    import time

    # Set TW_TIMING=1 so instrumented hooks self-report
    env = os.environ.copy()
    env['TW_TIMING'] = '1'

    tw_start = time.perf_counter()
    try:
        # stdout and stdin stay the terminal's, so task's confirmation prompts show and can be
        # answered; only stderr (Hook:/Perf lines, [timing] reports) is captured.
        result = run_task(['rc.debug.hooks=1'] + args, stderr=subprocess.PIPE, text=True, env=env)
    except Exception as e:
        print(f"[tw] Error running task: {e}", file=sys.stderr)
        return 1
    tw_end = time.perf_counter()
    total_wall_ms = (tw_end - tw_start) * 1000

    # --- Parse stderr for timing data ---
    # rc.debug.hooks=1 emits:
    #   Hook: Calling /path/hook.py          (one per hook fired)
    #   Perf task 2.6.2 ... hooks:N total:N  (aggregate, microseconds)
    # TW_TIMING=1 causes instrumented hooks to emit:
    #   [timing] hook-name.py: 12.3ms        (self-reported wall clock)

    hooks_called  = []   # basenames in call order (from Hook: Calling)
    hook_self_ms  = {}   # basename -> ms (from [timing] lines)
    perf          = {}

    perf_start_re = re.compile(r'^Perf\s+task\s+')
    perf_kv_re    = re.compile(r'(\w+):(\d+)')
    calling_re    = re.compile(r'^Hook: Calling (.+)$')
    timing_re     = re.compile(r'^\[timing\]\s+(.+?):\s+([\d.]+)ms$')
    debug_res     = [
        re.compile(r'^Hook:'),
        re.compile(r'^Found (?:hook|misnamed)'),
        re.compile(r'^Perf '),
        re.compile(r'^Timer '),
        re.compile(r'^Configuration override'),
        re.compile(r'^Applying context'),
        re.compile(r'^Detected context'),
        re.compile(r'^\s*\S+\.data\s+r[w-]'),
        re.compile(r'^Filtered \d+ tasks'),
        re.compile(r'^\s+MODIFICATION '),
        re.compile(r'^DEBUG'),
        re.compile(r'^Parse Tree'),
        re.compile(r'^\s+_(?:original_)?args'),
        re.compile(r'^\s+/usr/'),
        re.compile(r'^\s+word '),
        re.compile(r'^\s+pair '),
        re.compile(r'^\s+identifier '),
        re.compile(r'^\s+tag '),
        re.compile(r'^\s+task rc\.'),
    ]

    # Parse stderr: extract timing data, suppress debug noise, pass real messages
    ansi_re = re.compile(r'\x1b\[[0-9;]*m')
    for line in result.stderr.splitlines():
        m = calling_re.match(line)
        if m:
            hooks_called.append(Path(m.group(1)).name)
            continue
        m = timing_re.match(line)
        if m:
            hook_self_ms[m.group(1)] = float(m.group(2))
            continue
        if perf_start_re.match(line):
            perf = {k: int(v) for k, v in perf_kv_re.findall(line)}
            continue
        if any(r.match(ansi_re.sub('', line)) for r in debug_res):
            continue
        # Real message (project notices, hook feedback) — pass through
        print(line, file=sys.stderr)

    # --- Render timing report ---
    W       = 52
    cmd_str = ' '.join(args) if args else '(default)'

    print(f"\n[tw timing] task {cmd_str}", file=sys.stderr)
    print(f"  {'─'*W}", file=sys.stderr)

    def bar(ms, scale=50):
        return '#' * min(int(ms / scale), 20)

    if perf:
        init_ms  = (perf.get('init', 0) + perf.get('load', 0) + perf.get('gc', 0))   / 1000
        work_ms  = (perf.get('filter', 0) + perf.get('commit', 0) +
                    perf.get('sort', 0)   + perf.get('render', 0))                    / 1000
        hooks_ms =  perf.get('hooks', 0) / 1000
        other_ms =  perf.get('other', 0) / 1000
        task_ms  =  perf.get('total', 0) / 1000
        tw_ms    =  total_wall_ms - task_ms

        print(f"  tw wrapper overhead:    {tw_ms:7.1f}ms", file=sys.stderr)
        print(f"  task init/load/gc:      {init_ms:7.1f}ms  {bar(init_ms)}", file=sys.stderr)
        print(f"  task filter/commit/etc: {work_ms:7.1f}ms  {bar(work_ms)}", file=sys.stderr)
        if other_ms:
            print(f"  task other:             {other_ms:7.1f}ms  {bar(other_ms)}", file=sys.stderr)

        if hooks_called:
            print(f"  hooks total (Perf):     {hooks_ms:7.1f}ms  {bar(hooks_ms)}", file=sys.stderr)
            for name in hooks_called:
                self_ms = hook_self_ms.get(name)
                if self_ms is not None:
                    print(f"    |_ {name:<36s} {self_ms:6.1f}ms  {bar(self_ms, scale=20)}", file=sys.stderr)
                else:
                    print(f"    |_ {name}  (no TW_TIMING data — run make-awesome.py --timing)", file=sys.stderr)
            if len(hooks_called) > 1 and hook_self_ms:
                avg_ms = sum(hook_self_ms.values()) / len(hook_self_ms)
                print(f"       (~{avg_ms:.0f}ms avg per instrumented hook)", file=sys.stderr)
        else:
            print(f"  hooks:                  {hooks_ms:7.1f}ms  (none fired)", file=sys.stderr)

        print(f"  {'─'*W}", file=sys.stderr)
        print(f"  task total (Perf):      {task_ms:7.1f}ms", file=sys.stderr)
        print(f"  wall clock:             {total_wall_ms:7.1f}ms", file=sys.stderr)
    else:
        # No Perf data — show what we have from TW_TIMING lines
        if hooks_called:
            print(f"  hooks fired ({len(hooks_called)}):", file=sys.stderr)
            for name in hooks_called:
                self_ms = hook_self_ms.get(name)
                if self_ms is not None:
                    print(f"    |_ {name:<36s} {self_ms:6.1f}ms  {bar(self_ms, scale=20)}", file=sys.stderr)
                else:
                    print(f"    |_ {name}  (no TW_TIMING data)", file=sys.stderr)
        else:
            print(f"  (no hooks fired)", file=sys.stderr)
        print(f"  {'─'*W}", file=sys.stderr)
        print(f"  wall clock:             {total_wall_ms:7.1f}ms", file=sys.stderr)

    print(f"  {'─'*W}", file=sys.stderr)
    return result.returncode


def _interactive():
    """A person at a terminal: stdin and stdout both a tty (not a pipe, a script or tw-web)."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def _vit_wanted(args):
    """tw.ui=vit (a station's local.rc): a report task would run for args (default.command
    included) opens in vit, at a terminal. Never from inside vit (TW_CLIENT=vit: a shell or tw
    started there), never without vit on PATH. vit runs the report through tw itself, so
    pre-exec wrappers (theme-switch) still apply."""
    if os.environ.get('TW_CLIENT') == 'vit' or not _interactive():
        return False
    if TaskRC().get('tw.ui', '').split('#', 1)[0].strip().lower() != 'vit':
        return False
    if not shutil.which('vit'):
        return False
    return command_of(args, _task_vocab())[0] == 'report'


def pass_through_to_task(args, debug_wrapper=False):
    """Pass command through to task, routing via pre-exec and filter wrappers."""
    if _vit_wanted(args):
        os.execvp('vit', ['vit'] + list(args))
    wrapper_mgr = WrapperManager()
    session_id  = uuid.uuid4().hex[:12]

    # Pre-exec wrappers: run before task so they can patch config before task
    # reads it. run_pre_exec() returns None to abort, [] if none registered.
    # What task will run (one `task _show`, about 20 ms), only when a wrapper wants to know
    kind, name = (None, None)
    if wrapper_mgr.get_pre_exec() or wrapper_mgr.get_filters():
        kind, name = command_of(args, _task_vocab())
    report = name if kind == 'report' else ''

    ran_pre_exec = []
    if wrapper_mgr.get_pre_exec():
        ran_pre_exec = wrapper_mgr.run_pre_exec(args, session_id, report)
        if ran_pre_exec is None:
            return 1  # a pre-exec script signalled abort

    try:
        # Filter wrappers: report-only, pipe task output through registered scripts.
        if wrapper_mgr.get_filters() and report:
            rc = wrapper_mgr.run_through_filters(args, debug_wrapper=debug_wrapper, report=report)
            if rc is not None:
                return rc

        return run_task(args).returncode

    except Exception as e:
        print(f"[tw] Error executing task: {e}")
        return 1

    finally:
        if ran_pre_exec:
            wrapper_mgr.run_post_exec(ran_pre_exec, args, session_id, report)

def _completion_flags():
    return [f for f in TW_FLAGS if not f.hidden]


def _tw_command_flags():
    """Flags after which no task words follow (completion stops offering task's)."""
    return [n for f in _completion_flags() if not f.passthrough for n in _flag_names(f)]


# What each `complete` value offers, per shell
_BASH_WORDS = {
    'apps':      '"$(_tw_get_available_apps)"',
    'installed': '"$(_tw_get_installed_apps)"',
    'topics':    '"$(_tw_get_help_topics)"',
    'ids':       '"$(task _ids 2>/dev/null)"',
    'shells':    '"bash zsh fish"',
}
_ZSH_ACTIONS = {
    'apps': '_tw_available_apps', 'installed': '_tw_installed_apps', 'topics': '_tw_help_topics',
    'shells': '_tw_shell_types', 'ids': ' ', 'levels': '(1 2 3)',
}
_FISH_WORDS = {
    'apps': '(__fish_tw_available_apps)', 'installed': '(__fish_tw_installed_apps)',
    'topics': '(__fish_tw_help_topics)', 'shells': 'bash zsh fish', 'ids': '(task _ids 2>/dev/null)',
    'levels': '1 2 3',
}


def _bash_arg_cases():
    """The `case "${prev}"` arms: flags grouped by what their argument completes to. --debug's
    level goes after `=`, not as the next word, so it has none."""
    groups = {}
    for f in _completion_flags():
        if f.complete in _BASH_WORDS and f.kind != 'eq':
            groups.setdefault(f.complete, []).extend(_flag_names(f))
    return ''.join(
        f'        {"|".join(names)})\n'
        f'            COMPREPLY=( $(compgen -W {_BASH_WORDS[c]} -- ${{cur}}) )\n'
        f'            return 0\n'
        f'            ;;\n'
        for c, names in groups.items())


