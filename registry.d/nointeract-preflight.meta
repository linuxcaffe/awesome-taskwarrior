# nointeract-preflight.meta
# Bulk-operation pre-flight guard for non-interactive Taskwarrior clients

name=nointeract-preflight
version=0.1.0
type=hook
description=Bulk-operation pre-flight guard: blocks mutating commands that affect many tasks when running under non-interactive clients (TW_NOINTERACT=1), emitting a structured JSON signal so the client can confirm before proceeding.
repo=https://github.com/linuxcaffe/tw-nointeract-preflight-hook
base_url=https://raw.githubusercontent.com/linuxcaffe/tw-nointeract-preflight-hook/master
files=on-launch_nointeract-preflight.py:hook
tags=safety,bulk,nointeract,hook,web,gui

author=linuxcaffe + Claude Sonnet 4.6
license=MIT
requires_taskwarrior=2.6.0
