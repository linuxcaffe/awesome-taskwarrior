def _zsh_spec(f):
    """One _arguments spec: '(-I --install)'{-I,--install}'[Install an application]:app:action'."""
    desc = f.help.replace(']', '\\]').replace("'", "'\\''")
    action = _ZSH_ACTIONS.get(f.complete)
    label = f.param.strip('[]=').lower() or f.complete or 'arg'
    if f.kind == 'eq':
        names, arg = [f.long + '=-'], f'::{label}:{action or " "}'
    else:
        names = _flag_names(f)
        if f.kind == 'arg':
            arg = f':{label}:{action or " "}'
        elif f.kind == 'opt' or action:
            arg = f'::{label}:{action or " "}'
        else:
            arg = ''
    if len(names) > 1:
        return f"'({' '.join(names)})'{{{','.join(names)}}}'[{desc}]{arg}'"
    return f"'{names[0]}[{desc}]{arg}'"


