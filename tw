    Flag('-V', '--vit',                 'flag', 'Open a report in vit', '[cmd]', passthrough=True),
]
TW_SHORT_FLAGS = [f.short for f in TW_FLAGS if f.short and not f.hidden]
TW_LONG_FLAGS = [f.long for f in TW_FLAGS if not f.hidden]
TW_HIDDEN_FLAGS = [f.long for f in TW_FLAGS if f.hidden]
TW_PREFIX_FLAGS = ('--debug', '--timing')


def _flag_names(f):
    return [n for n in (f.short, f.long) if n]


def _is_tw_flag(arg):
    return arg in TW_SHORT_FLAGS or arg.split('=')[0] in TW_LONG_FLAGS


def run_task(args, **kwargs):
    """subprocess.run of `task args` (kwargs as for subprocess.run; check defaults to False).
    argv[0] stays 'task' while the binary found on PATH runs: task derives its own path from
    argv[0] for sub-processes, and a full path there gets mangled (calendar --details=full turned
    /usr/local/bin/task into /usr/lotask). Without a task on PATH: says so, returns exit 127."""
    argv = ['task'] + list(args)
    exe = shutil.which('task')
    if not exe:
        print("[tw] Error: task executable not found", file=sys.stderr)
        return subprocess.CompletedProcess(argv, 127, '', '')
    kwargs.setdefault('check', False)
    return subprocess.run(argv, executable=exe, **kwargs)


# Taskwarrior 2.6.2's commands (`task _commands`; 2.6.2 is fixed, so the list is too).
TASK_COMMANDS = frozenset("""
    _aliases _columns _commands _config _context _get _ids _projects _show _tags _udas _unique
    _urgency _uuids _version _zshattributes _zshcommands _zshids _zshuuids
    active add all annotate append blocked blocking burndown.daily burndown.monthly
    burndown.weekly calc calendar colors columns commands completed config context count delete
    denotate diagnostics done duplicate edit execute export ghistory.annual ghistory.daily
    ghistory.monthly ghistory.weekly help history.annual history.daily history.monthly
    history.weekly ids import information list log logo long ls minimal modify newest news next
    oldest overdue prepend projects purge ready recurring reports show start stats stop summary
    synchronize tags timesheet udas unblocked undo uuids version waiting
""".split())


def _is_task_command(arg, minimum=2):
    """True when task would read arg as a command: a 2.6.2 command or an abbreviation of one
    (abbreviation.minimum, default 2), ambiguous or not."""
    if arg in TASK_COMMANDS:
        return True
    if len(arg) < minimum or not re.fullmatch(r'[a-z_][a-z0-9._]*', arg):
        return False
    return any(c.startswith(arg) for c in TASK_COMMANDS)


class WrapperManager:
    """Manages wrapper dispatch for tw.

    Three wrapper types, registered in ~/.task/config/.tw_wrappers:
        keyword|script|description|type

    type=command  (default) — keyword found in args triggers dispatch.
        Example: ann|annn|Annotation manager|command
        tw 42 ann.1  → detects 'ann', runs: annn 42.1

    type=filter  — output filter applied to any report command.
        Example: nicedates|nicedates|Nice date formatting|filter
        tw next  → runs: task next | nicedates
        Multiple filter wrappers are chained in registration order.

    type=pre-exec  — runs before task (and again after, for cleanup).
        Example: theme-switch|theme-wrap.py|Per-report theme switching|pre-exec
        tw list  → calls theme-wrap.py (TW_PRE_EXEC_PHASE=pre, TW_REPORT=list)
                   then runs: task list
                   then calls theme-wrap.py (TW_PRE_EXEC_PHASE=post)
        Scripts receive TW_PRE_EXEC_PHASE, TW_REPORT, TW_PRE_EXEC_SESSION env vars.
        Multiple pre-exec wrappers run in registration order (post runs in reverse).
        If any pre-exec script exits non-zero, task is aborted.

    The type field is optional; omitting it defaults to 'command' for
    backward compatibility with existing .tw_wrappers entries.
    """
    
    WRAPPERS_FILE = Path.home() / ".task" / "config" / ".tw_wrappers"
    
    def __init__(self):
        self._wrappers = None  # Lazy load
    
    @property
    def wrappers(self):
        """Lazy-load registered wrappers."""
        if self._wrappers is None:
            self._wrappers = self._load()
        return self._wrappers
    
    def _load(self):
        """Read .tw_wrappers registry file.
        
        Format: keyword|script|description[|type]
        type defaults to 'command' if omitted.
        """
        result = {}
        if not self.WRAPPERS_FILE.exists():
            return result
        
        try:
            with open(self.WRAPPERS_FILE, 'r') as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#'):
                        continue
                    parts = line.split('|')
                    if len(parts) >= 2:
                        keyword = parts[0].strip()
                        script  = parts[1].strip()
                        desc    = parts[2].strip() if len(parts) > 2 else ""
                        wtype   = parts[3].strip().lower() if len(parts) > 3 else "command"
                        result[keyword] = {
                            'script':      script,
                            'description': desc,
                            'type':        wtype,
                        }
            debug(f"WrapperManager: loaded {len(result)} wrapper(s)", 2)
        except Exception as e:
            debug(f"WrapperManager: error reading wrappers file: {e}", 1)
        
        return result
    
    def find_keyword(self, args):
        """Scan args for a registered wrapper keyword.
        
        Returns (keyword, filter_args, action) or (None, None, None).
        
        Handles:
            tw 42 ann        → filter=['42'], keyword='ann', action=''
            tw 42 ann.       → filter=['42'], keyword='ann', action='.'
            tw 42 ann.1      → filter=['42'], keyword='ann', action='.1'
            tw 42 ann -1     → filter=['42'], keyword='ann', action='-1'
            tw 42 -ann.1     → filter=['42'], keyword='ann', action='-ann.1' (remove)
        
        Also detects keyword embedded in an arg:
            tw 42 ann.1      → 'ann' found inside 'ann.1'

        A keyword counts only where task would look for its command: before `--` and before
        the first task command word (abbreviations included), so task text is never one
        (`tw add sync phone` adds a task). tw's own flags first mean no wrapper at all
        (`tw -u events` updates the events app), except the prefix flags --debug/--timing.
        """
        if not self.wrappers:
            return None, None, None
        if args and _is_tw_flag(args[0]) and not args[0].split('=')[0] in TW_PREFIX_FLAGS:
            return None, None, None

        for i, arg in enumerate(args):
            if arg == '--':
                break
            # Check each registered keyword
            for keyword in self.wrappers:
                # Skip non-command wrappers — they are not keyword dispatchers
                if self.wrappers[keyword].get('type') in ('filter', 'pre-exec'):
                    continue
                # Exact match: "ann"
                if arg == keyword:
                    filter_args = args[:i]
                    action_args = args[i+1:]
                    return keyword, filter_args, action_args
                
                # Keyword with dot suffix: "ann.", "ann.1", "ann.3"
                if arg.startswith(keyword + '.'):
                    filter_args = args[:i]
                    suffix = arg[len(keyword):]  # ".1", "."
                    return keyword, filter_args, [suffix]
                
                # Remove syntax: "-ann.1" → remove mode
                if arg.startswith('-' + keyword + '.'):
                    filter_args = args[:i]
                    return keyword, filter_args, [arg]
            if _is_task_command(arg):
                break       # task's command: what follows is its text, not a wrapper

        return None, None, None
    
    def dispatch(self, keyword, filter_args, action_args, debug_wrapper=False):
        """Dispatch to wrapper script.
        
        Translates tw args into wrapper invocation.
        Example: keyword='ann', filter=['42'], action=['.1']
                 → runs: annn 42.1
        """
        wrapper = self.wrappers.get(keyword)
        if not wrapper:
            return 1
        
        script = wrapper['script']
        
        # Find the script - check PATH and ~/.task/scripts/
        script_path = shutil.which(script)
        if not script_path:
            scripts_dir = Path.home() / ".task" / "scripts" / script
            if scripts_dir.exists():
                script_path = str(scripts_dir)
            else:
                print(f"[tw] Error: wrapper script '{script}' not found")
                print(f"[tw] Searched PATH and ~/.task/scripts/")
                return 1
        
        # Build wrapper command
        # Filter args become the first arg (task ID/filter)
        # Action args get appended
        cmd = [script_path]
        
        if filter_args:
            # If action starts with "." or "-", combine with filter for dot syntax
            # e.g. filter=['42'], action=['.1'] → '42.1'
            # e.g. filter=['42'], action=['-ann.1'] → extract '-42.1'
            # Strip tw-own flags (--timing, --debug, etc.) that may precede the
            # task ID when find_keyword() runs before argparse sees them.
            task_filter_args = [a for a in filter_args if not a.startswith('--')]
            if not task_filter_args:
                # All filter args were tw flags — no task ID, dispatch without one
                cmd.extend(action_args)
                if debug_wrapper:
                    print(f"[tw-debug] Wrapper dispatch: {' '.join(cmd)}", file=sys.stderr)
                result = subprocess.run(cmd, check=False)
                return result.returncode
            filter_str = ' '.join(task_filter_args) if len(task_filter_args) > 1 else task_filter_args[0]
            
            if action_args and action_args[0].startswith('-' + keyword + '.'):
                # Remove syntax: -ann.1 → -42.1
                index = action_args[0][len('-' + keyword + '.'):]
                cmd.append(f'-{filter_str}.{index}')
            elif action_args and action_args[0].startswith('.'):
                # Dot syntax: .1 → 42.1, . → 42.
                cmd.append(f'{filter_str}{action_args[0]}')
            else:
                cmd.append(filter_str)
                cmd.extend(action_args)
        else:
            cmd.extend(action_args)
        
        if debug_wrapper:
            print(f"[tw-debug] Wrapper dispatch: {' '.join(cmd)}", file=sys.stderr)
        
        # Execute wrapper, inheriting stdin for pipe support
        try:
            result = subprocess.run(cmd, check=False)
            return result.returncode
        except KeyboardInterrupt:
            return 130
    
    def list_wrappers(self):
        """List registered wrappers for help display."""
        return self.wrappers

    def get_filters(self):
        """Return ordered list of registered filter-type wrappers.
        
        Filter wrappers receive task output on stdin and write
        transformed output to stdout. Multiple filters are chained.
        Returns list of {'keyword', 'script', 'description'} dicts.
        """
        return [
            {'keyword': kw, **info}
            for kw, info in self.wrappers.items()
            if info.get('type') == 'filter'
        ]

    def get_pre_exec(self):
        """Return ordered list of registered pre-exec wrappers.

        Pre-exec wrappers run before task executes (and again after for cleanup),
        allowing side-effects like patching config files before task reads them.
        Returns list of {'keyword', 'script', 'description'} dicts.
        """
        return [
            {'keyword': kw, **info}
            for kw, info in self.wrappers.items()
            if info.get('type') == 'pre-exec'
        ]

    @staticmethod
    def _phase_env(phase, task_args, session_id, report):
        env = os.environ.copy()
        env['TW_PRE_EXEC_PHASE']   = phase
        env['TW_REPORT']           = report or ''
        env['TW_PRE_EXEC_SESSION'] = session_id
        env['TW_TASK_ARGS']        = json.dumps(task_args)
        return env

    def run_pre_exec(self, task_args, session_id, report=''):
        """Call all pre-exec wrappers with TW_PRE_EXEC_PHASE=pre. report is the report task will
        run (alias, abbreviation and default.command resolved), '' for anything else.

        Returns list of resolved script paths that ran successfully (for post-exec),
        or None if any script exits non-zero (signals task should be aborted).
        """
        pre_exec = self.get_pre_exec()
        if not pre_exec:
            return []
        ran = []
        for w in pre_exec:
            script_path = self.resolve_script(w['script'])
            if not script_path:
                debug(f"WrapperManager: pre-exec script not found: {w['script']}", 1)
                continue
            env = self._phase_env('pre', task_args, session_id, report)
            result = subprocess.run([script_path], env=env, check=False)
            if result.returncode != 0:
                debug(f"WrapperManager: pre-exec aborted by {w['script']} (rc={result.returncode})", 1)
                return None
            ran.append(script_path)
        return ran

    def run_post_exec(self, ran_scripts, task_args, session_id, report=''):
        """Call pre-exec wrappers again with TW_PRE_EXEC_PHASE=post for cleanup.

        Runs in reverse registration order so cleanups unwind correctly.
        Always called (in finally), regardless of task exit code.
        """
        for script_path in reversed(ran_scripts):
            env = self._phase_env('post', task_args, session_id, report)
            try:
                subprocess.run([script_path], env=env, check=False)
            except Exception as e:
                debug(f"WrapperManager: post-exec error for {script_path}: {e}", 1)

    def resolve_script(self, script):
        """Find script in PATH or ~/.task/scripts/. Returns path or None."""
        path = shutil.which(script)
        if path:
            return path
        candidate = Path.home() / ".task" / "scripts" / script
        if candidate.exists():
            return str(candidate)
        return None

    def run_through_filters(self, task_args, debug_wrapper=False, report=None):
        """Run task via PTY (preserving colors) and pipe output through filter wrappers.

        Uses a pseudo-terminal so task produces full color/width output, then
        feeds the captured bytes through each registered filter in order:
            task [args]  ->  PTY capture  ->  filter1.stdin  ->  terminal

        Returns exit code of the task process.
        """
        import pty
        import select as _select

        filters = self.get_filters()

        # Resolve all filter scripts first -- fail early if any missing
        resolved = []
        for f in filters:
            script_path = self.resolve_script(f['script'])
            if not script_path:
                print(f"[tw] Error: filter script '{f['script']}' not found")
                print(f"[tw] Searched PATH and ~/.task/scripts/")
                return 1
            resolved.append(script_path)
            debug(f"WrapperManager: filter resolved: {f['keyword']} -> {script_path}", 2)

        if debug_wrapper:
            chain = ' | '.join([f"task {' '.join(task_args)}"] + resolved)
            print(f"[tw-debug] Filter chain (PTY): {chain}", file=sys.stderr)

        task_bin = shutil.which('task')
        if not task_bin:
            print("[tw] Error: task executable not found")
            return 1

        # Get terminal dimensions so task renders at the correct width
        try:
            term_cols, term_rows = os.get_terminal_size()
        except OSError:
            term_cols, term_rows = 80, 24

        env = os.environ.copy()
        env['COLUMNS'] = str(term_cols)
        env['LINES']   = str(term_rows)

        # Run task under a PTY so it believes it has a real terminal
        master_fd, slave_fd = pty.openpty()

        # Inject rc overrides so task outputs the canonical date format
        # that filter scripts (e.g. nicedates) expect to parse.
        rc_overrides = [
            'rc._forcecolor=on',
            'rc.dateformat=Y-M-D H:N:S',
            'rc.verbose=all,-override',
        ]
        task_proc = subprocess.Popen(
            ['task'] + rc_overrides + task_args,
            executable=task_bin,
            stdin=slave_fd,
            stdout=slave_fd,
            stderr=slave_fd,
            env=env,
        )
        os.close(slave_fd)

        # Drain the PTY master into a buffer. Read until every writer has closed the terminal
        # (EIO), or, once task has exited, until it has been quiet for PTY_QUIET seconds: a child
        # task left behind (a hook's background job) may still write a little, or may hold the
        # terminal open and say nothing, which must not keep tw waiting.
        import time as _time
        PTY_QUIET = 0.3
        output = b''
        quiet_since = None          # set once task has exited; reset by any later output
        while True:
            ready, _, _ = _select.select([master_fd], [], [], 0.05)
            if ready:
                try:
                    chunk = os.read(master_fd, 65536)
                except OSError:
                    break           # EIO: nobody has the terminal open any more
                if not chunk:
                    break
                output += chunk
                if quiet_since is not None:
                    quiet_since = _time.monotonic()
            elif task_proc.poll() is not None:
                now = _time.monotonic()
                if quiet_since is None:
                    quiet_since = now
                elif now - quiet_since >= PTY_QUIET:
                    break

        os.close(master_fd)
        task_proc.wait()
        task_rc = task_proc.returncode
        debug(f"WrapperManager: task exit={task_rc}, captured {len(output)} bytes", 2)

        # Chain filter processes: feed PTY output into first filter's stdin.
        # For a single filter (common case), communicate() is simplest.
        # For multiple filters, chain communicate() calls in sequence.

        # Set NICEDATES_REPORT so filter scripts can honour nice.reports=
        filter_env = os.environ.copy()
        if report:
            filter_env['NICEDATES_REPORT'] = report

        current_input = output
        for i, script_path in enumerate(resolved):
            is_last = (i == len(resolved) - 1)
            filter_proc = subprocess.Popen(
                [script_path],
                stdin=subprocess.PIPE,
                stdout=None if is_last else subprocess.PIPE,
                stderr=None,  # inherit stderr so filter messages reach terminal
                env=filter_env,
            )
            if is_last:
                # Last filter streams directly to terminal (stdout=None=inherited)
                filter_proc.stdin.write(current_input)
                filter_proc.stdin.close()
                filter_proc.wait()
            else:
                # Intermediate filter: capture output for next stage
                stdout_bytes, _ = filter_proc.communicate(input=current_input)
                current_input = stdout_bytes

        return task_rc  # task's exit code is authoritative



def _fetch(url, timeout=30, headers=None):
    """The bytes at url, or None (said at debug level 1). Every download tw makes goes here."""
    try:
        req = Request(url, headers=headers or {})
        with urlopen(req, timeout=timeout) as response:
            return response.read()
    except (URLError, HTTPError, OSError, ValueError) as e:
        debug(f"Fetch failed: {url}: {e}", 1)
        return None


class RegistryManager:
    """The registry: registry.d/ beside tw in dev mode, else GitHub.

    From GitHub, tw first reads registry.d/index.json (every app's .meta text, written by
    make-awesome.py) in one request; without it, it lists registry.d through the GitHub API and
    fetches each .meta. Metas are cached for the run."""
    
    INDEX_URL = f"{GITHUB_RAW_BASE}/registry.d/index.json"

    def __init__(self, paths):
        self.paths = paths
        self.is_dev_mode = paths.is_dev_mode
        self._meta_cache = {}
        self._index = None          # {name: .meta text}, {} once it has failed
    
    def _remote_index(self):
        if self._index is None:
            self._index = {}
            data = _fetch(self.INDEX_URL)
            try:
                metas = json.loads(data)['metas'] if data else {}
                if isinstance(metas, dict):
                    self._index = metas
            except (ValueError, KeyError, TypeError) as e:
                debug(f"Registry index unreadable: {e}", 1)
            debug(f"Registry index: {len(self._index)} app(s)", 2)
        return self._index

    def list_apps(self):
        """All application names in the registry, sorted"""
        if self.is_dev_mode:
            debug("Listing apps from local registry", 2)
            return sorted(p.stem for p in self.paths.local_registry.glob("*.meta"))
        if self._remote_index():
            return sorted(self._remote_index())
        debug("Fetching apps from GitHub registry", 2)
        data = _fetch(f"{GITHUB_API_BASE}/contents/registry.d", timeout=10,
                      headers={'Accept': 'application/vnd.github.v3+json'})
        try:
            return sorted(item['name'][:-5] for item in json.loads(data)
                          if item['name'].endswith('.meta'))
        except (TypeError, ValueError, KeyError):
            print("[tw] [!] Failed to fetch registry from GitHub")
            return []
    
    def get_metas(self, app_names, workers=8):
        """{name: MetaFile} for the apps that have one, in the order given. Outside dev mode without
        an index each is an HTTPS fetch, so they run in parallel; get_meta caches them for this run."""
        from concurrent.futures import ThreadPoolExecutor
        names = list(app_names)
        with ThreadPoolExecutor(max_workers=max(1, min(workers, len(names)))) as pool:
            metas = list(pool.map(self.get_meta, names))
        return {n: m for n, m in zip(names, metas) if m}

    def get_meta(self, app_name):
        """MetaFile for an app, or None (cached for this run)"""
        if app_name not in self._meta_cache:
            self._meta_cache[app_name] = self._get_meta(app_name)
        return self._meta_cache[app_name]

    def _get_meta(self, app_name):
        if self.is_dev_mode:
            meta_path = self.paths.local_registry / f"{app_name}.meta"
            return MetaFile(meta_path) if meta_path.exists() else None
        text = self._remote_index().get(app_name)
        if text is None:
            data = _fetch(f"{GITHUB_RAW_BASE}/registry.d/{app_name}.meta", timeout=10)
            text = data.decode() if data else None
        return MetaFile.from_text(text) if text is not None else None
    
    def get_installer(self, app_name, dest_dir=None):
        """Path to an app's installer: the local file in dev mode, else downloaded into dest_dir
        (a new temp dir when None; the caller removes it). None when there is none."""
        if self.is_dev_mode:
            installer_path = self.paths.local_installers / f"{app_name}.install"
            return installer_path if installer_path.exists() else None
        data = _fetch(f"{GITHUB_RAW_BASE}/installers/{app_name}.install")
        if data is None:
            return None
        dest = Path(dest_dir or tempfile.mkdtemp(prefix=f'tw-installer-{app_name}-'))
        installer = dest / f"{app_name}.install"
        installer.write_bytes(data)
        installer.chmod(0o755)
        return installer

class MetaFile:
    """Parses and manages .meta files for applications"""
    
    def __init__(self, meta_path=None, text=None):
        self.meta_path = Path(meta_path) if meta_path else None
        if text is None and self.meta_path and self.meta_path.exists():
            text = self.meta_path.read_text()
        self.data = {}
        for line in (text or '').splitlines():
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                key, value = line.split('=', 1)
                self.data[key.strip()] = value.strip()

    @classmethod
    def from_text(cls, text):
        return cls(text=text)
    
    def get(self, key, default=None):
        """Get a value from the meta file"""
        return self.data.get(key, default)
    
    def get_files(self):
        """Parse files= field into list of (filename, type) tuples
        
        Format: files=file1.py:hook,file2.sh:script,config.rc:config
        Returns: [('file1.py', 'hook'), ('file2.sh', 'script'), ...]
        """
        files_str = self.get('files', '')
        if not files_str:
            return []
        
        return [(name, ftype) for name, ftype, _ in self._file_entries()]

    def _file_entries(self):
        """[(filename, type, dest or None)]: an entry is name[:type[:dest]], type defaulting to 'file'."""
        result = []
        for item in self.get('files', '').split(','):
            parts = [p.strip() for p in item.strip().split(':', 2)]
            if parts[0]:
                result.append((parts[0], parts[1] if len(parts) > 1 else 'file',
                               parts[2] if len(parts) > 2 and parts[2] else None))
        return result

    def get_dest(self, filename, task_dir):
        """Where an entry's third field puts the file, or None: `~/...` or absolute as written,
        `docs/x.md` under task_dir; a bare folder name (`scripts`) just restates the type's folder."""
        for name, _, dest in self._file_entries():
            if name == filename and dest:
                p = Path(dest).expanduser()
                if p.is_absolute():
                    return p
                if '/' in dest:
                    return Path(task_dir) / dest
        return None
    
    def get_base_url(self):
        """Get base URL for file downloads"""
        return self.get('base_url', '')
    
    def get_checksums(self):
        """Parse checksums= field into list of checksums
        
        Format: checksums=hash1,hash2,hash3
        Returns: ['hash1', 'hash2', 'hash3']
        """
        checksums_str = self.get('checksums', '')
        if not checksums_str:
            return []
        
        return [c.strip() for c in checksums_str.split(',') if c.strip()]
    
    def get_tags(self):
        """Parse tags= field into list of tags
        
        Format: tags=python,hook,stable
        Returns: ['python', 'hook', 'stable']
        """
        tags_str = self.get('tags', '')
        if not tags_str:
            return []
        
        return [t.strip() for t in tags_str.split(',') if t.strip()]

def _portable(path):
    """How the manifest records a file: ~/... under the home folder, so the shared ~/.task (gittw)
    holds the same line on every station. Another station's absolute ~/.task path (an older tw or a
    standalone installer wrote it) becomes ~/.task/...; a URL or a path elsewhere stays as written."""
    if not path.startswith('/'):
        return path
    home = str(Path.home()).rstrip('/') + '/'
    if path.startswith(home):
        return '~/' + path[len(home):]
    if '/.task/' in path:
        return '~/.task/' + path.split('/.task/', 1)[1]
    return path


def _local(path):
    """A manifest path as this station's absolute path (what installers and tw's own code use)."""
    return os.path.expanduser(path) if path.startswith('~/') else path


class Manifest:
    """Manages the installation manifest. On disk the paths are portable (_portable), because
    ~/.task is shared between stations; in memory, and while an installer runs, they are this
    station's absolute paths: installers read them back with `[ -f "$file" ]`, which no ~ survives."""
    
    def __init__(self, manifest_path):
        self.manifest_path = Path(manifest_path)
        self.entries = []
        self.portable_on_disk = True     # every line already written the portable way
        self._load()
    
    def _load(self):
        """Load manifest from file"""
        if not self.manifest_path.exists():
            return
        
        with open(self.manifest_path, 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                parts = line.split('|')
                if len(parts) >= 5:
                    if _portable(parts[2]) != parts[2]:
                        self.portable_on_disk = False
                    self.entries.append({
                        'app': parts[0],
                        'version': parts[1],
                        'file': _local(_portable(parts[2])),
                        'checksum': parts[3],
                        'date': parts[4]
                    })
    
    def add(self, app, version, file_path, checksum=''):
        """Add an entry to the manifest"""
        # Remove any existing entry for this file
        self.entries = [e for e in self.entries 
                       if not (e['app'] == app and e['file'] == file_path)]
        
        # Add new entry
        entry = {
            'app': app,
            'version': version,
            'file': file_path,
            'checksum': checksum,
            'date': datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')
        }
        self.entries.append(entry)
        self._save()
    
    def remove_app(self, app):
        """Remove all entries for an app"""
        self.entries = [e for e in self.entries if e['app'] != app]
        self._save()
    
    def shared_files(self, app):
        """The app's files that another app lists too."""
        others = {e['file'] for e in self.entries if e['app'] != app}
        return [f for f in self.get_files(app) if f in others]

    def claim(self, app):
        """The app was just installed: its files are its alone. Drop every other app's line for
        them (an app installed earlier under another name, say). Returns {other app: [files]}."""
        mine = set(self.get_files(app))
        taken = {}
        for e in self.entries:
            if e['app'] != app and e['file'] in mine:
                taken.setdefault(e['app'], []).append(e['file'])
        if taken:
            self.entries = [e for e in self.entries if e['app'] == app or e['file'] not in mine]
            self._save()
        return taken

    def get_files(self, app):
        """Get list of files for an app"""
        return [e['file'] for e in self.entries if e['app'] == app]
    
    def is_installed(self, app):
        """Check if an app is installed"""
        return any(e['app'] == app for e in self.entries)
    
    def apps(self):
        """{app: version} of every installed app, in manifest order"""
        result = {}
        for e in self.entries:
            result.setdefault(e['app'], e['version'])
        return result

    def get_version(self, app):
        """Get installed version of an app"""
        for e in self.entries:
            if e['app'] == app:
                return e['version']
        return None
    
    def normalize(self):
        """Rewrite the file the portable way when any line isn't (once, after an older tw)."""
        if not self.portable_on_disk and self.manifest_path.exists():
            self._save()

    def _save(self, local=False):
        """Save manifest to file: portable paths, or this station's (local=True, for an installer)."""
        self.manifest_path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.manifest_path, 'w') as f:
            for entry in self.entries:
                line = '|'.join([
                    entry['app'],
                    entry['version'],
                    entry['file'] if local else _portable(entry['file']),
                    entry['checksum'],
                    entry['date']
                ])
                f.write(line + '\n')
        self.portable_on_disk = not local

_INCLUDE_RE = re.compile(r'^(\s*)include\s+(\S.*?)\s*$')
_SYSTEM_RC_DIR = Path('/usr/share/taskwarrior')


def _include_target(value, including_file):
    """Where Taskwarrior 2.6.2 finds `include value`: absolute or ~ as written; else the
    including file's folder; else /usr/share/taskwarrior. None when nothing is there."""
    p = Path(os.path.expanduser(value))
    candidates = [p] if p.is_absolute() else [including_file.parent / p, _SYSTEM_RC_DIR / p]
    return next((c for c in candidates if c.is_file()), None)


def repair_dangling_includes(taskrc, note='tw', _seen=None):
    """Comment out every `include` in the taskrc chain whose file is missing, so `task` still
    starts. Returns one description per line changed. Edits through symlinks (gittw's .taskrc)."""
    fixed = []
    _seen = set() if _seen is None else _seen
    rcfile = Path(taskrc).expanduser()
    try:
        real = rcfile.resolve()
        if real in _seen or not real.is_file():
            return fixed
        _seen.add(real)
        lines = real.read_text().splitlines(keepends=True)
    except OSError:
        return fixed
    changed = False
    stamp = datetime.now().strftime('%Y-%m-%d')
    for i, line in enumerate(lines):
        m = _INCLUDE_RE.match(line.rstrip('\n'))
        if not m:
            continue
        target = _include_target(m.group(2), real)
        if target is None:
            lines[i] = f"#{line.rstrip(chr(10)).lstrip()}   # {note} {stamp}: file missing\n"
            fixed.append(f"{real}:{i + 1}: include {m.group(2)}")
            changed = True
        else:
            fixed += repair_dangling_includes(target, note, _seen)
    if changed:
        real.write_text(''.join(lines))
    return fixed


def _repair_after_remove(paths, app_name):
    taskrc = Path(os.environ.get('TASKRC') or paths.taskrc)
    for item in repair_dangling_includes(taskrc, note=f'tw -r {app_name}'):
        print(f"[tw] [!] Commented out an include whose file is gone: {item}")


class AppManager:
    """Manages application installation, removal, and updates"""
    
    def __init__(self, paths):
        self.paths = paths
        self.manifest = Manifest(paths.manifest_file)
        try:
            self.manifest.normalize()
        except OSError:
            pass
        self.registry = RegistryManager(paths)
        self.rc = TaskRC()
    
    def _installer_env(self, dry_run=False):
        """What an installer is told: where everything goes."""
        env = os.environ.copy()
        env.update({
            'INSTALL_DIR': str(self.paths.task_dir),
            'HOOKS_DIR': str(self.paths.hooks_dir),
            'SCRIPTS_DIR': str(self.paths.scripts_dir),
            'CONFIG_DIR': str(self.paths.config_dir),
            'DOCS_DIR': str(self.paths.docs_dir),
            'LOGS_DIR': str(self.paths.logs_dir),
            'TASKRC': str(self.paths.taskrc),
            'TW_COMMON': str(self.paths.lib_dir / 'tw-common.sh'),
        })
        if dry_run:
            env['TW_DRY_RUN'] = '1'
        return env

    def _run_installer(self, installer_path, action):
        """bash INSTALLER install|remove; True when it exits 0. The installer sees the manifest with
        this station's paths and may append its own; afterwards the file is portable again."""
        mf = self.paths.manifest_file
        if mf.exists():
            Manifest(mf)._save(local=True)
        try:
            result = subprocess.run(['bash', str(installer_path), action], env=self._installer_env())
            return result.returncode == 0
        except OSError as e:
            print(f"[tw] [X] Error running installer: {e}")
            return False
        finally:
            if mf.exists():
                Manifest(mf)._save()

    def install(self, app_name, dry_run=False, stage_dir=None):
        """Install an application with its installer, run from a folder holding its files (so the
        installer's SCRIPT_DIR finds them): stage_dir when given (tw -u staged it), else a fresh
        stage outside dev mode, else the local installers/ in dev mode."""
        debug(f"AppManager.install: Getting installer for {app_name}", 2)
        own_stage = None
        try:
            if stage_dir:
                installer_path = stage_dir / f"{app_name}.install"
            elif not self.paths.is_dev_mode:
                meta = self.registry.get_meta(app_name)
                if not meta:
                    print(f"[tw] [X] Meta not found for: {app_name}")
                    return False
                own_stage = stage_dir = self._stage_downloads(app_name, meta)
                if not stage_dir:
                    return False
                installer_path = stage_dir / f"{app_name}.install"
            else:
                installer_path = self.registry.get_installer(app_name)

            if not installer_path or not installer_path.exists():
                print(f"[tw] [X] Installer not found: {app_name}")
                return False
            debug(f"AppManager.install: Installer path: {installer_path}", 2)

            if dry_run:
                print(f"[tw] DRY RUN: Would execute: bash {installer_path} install")
                meta = self.registry.get_meta(app_name)
                files = meta.get_files() if meta else []
                if files:
                    print(f"[tw] Would install {len(files)} file(s):")
                    for filename, file_type in files:
                        dest = meta.get_dest(filename, self.paths.task_dir)
                        print(f"[tw]   {filename} -> {dest or str(self._get_target_dir(file_type)) + '/'}")
                return True

            if self._run_installer(installer_path, 'install'):
                print(f"[tw] [+] Installed: {app_name}")
                self._claim(app_name)
                if not stage_dir or own_stage:      # tw -u prints these once, after the update
                    self._station_notes(app_name)
                return True
            print(f"[tw] [X] Installation failed: {app_name}")
            return False
        finally:
            if own_stage:
                shutil.rmtree(own_stage, ignore_errors=True)
    
    # ── This station ──────────────────────────────────────────────────────────
    # ~/.task is shared between stations (gittw), so an app's files are on every one; what differs is
    # what runs. A station with its own hooks.location (tw-mobilize: ~/.task/hooks.d/<station>, in its
    # local.rc) runs only the hooks linked there, and files outside ~/.task never travel.

    def _rc_value(self, key, default=''):
        return self.rc.get(key, default).split('#', 1)[0].strip()

    def station_hooks_dir(self):
        """This station's own hooks folder, or None when it runs ~/.task/hooks (the default)."""
        value = self._rc_value('hooks.location')
        if not value:
            return None
        folder = Path(os.path.expanduser(value))
        try:
            if folder.resolve() == self.paths.hooks_dir.resolve():
                return None
        except OSError:
            pass
        return folder

    def hooks_off(self):
        return self._rc_value('hooks', 'on').lower() in ('off', 'no', '0', 'false')

    def station_platform(self):
        """desktop or mobile (tw.platforms in local.rc), '' when the station doesn't say."""
        return self._rc_value('tw.platforms').lower()

    def _hook_files(self, app_name):
        return [Path(f) for f in self.manifest.get_files(app_name)
                if Path(f).parent == self.paths.hooks_dir and Path(f).name.startswith('on-')]

    def not_here(self, app_name):
        """Why an installed app isn't (all) at work on this station, or None when it is."""
        files = [Path(f) for f in self.manifest.get_files(app_name) if f.startswith('/')]
        missing = [f for f in files if not (f.exists() or f.is_symlink())]
        if missing:
            return f"{len(missing)} file(s) not on this station"
        hooks = self._hook_files(app_name)
        if not hooks:
            return None
        if self.hooks_off():
            return "hooks = off here"
        own = self.station_hooks_dir()
        if own is None:
            return None
        running = [h for h in hooks if (own / h.name).exists()]
        if not running:
            return f"its hooks don't run here ({_portable(str(own))})"
        if len(running) < len(hooks):
            return f"{len(running)} of {len(hooks)} hooks run here"
        return None

    def not_for_here(self, meta):
        """'desktop only' when the app's platforms= leaves out this station's kind, else None."""
        platforms = [p.strip().lower() for p in (meta.get('platforms') or '').split(',') if p.strip()]
        here = self.station_platform()
        if platforms and here and here not in platforms:
            return f"{'/'.join(platforms)} only"
        return None

    def _station_notes(self, app_name, meta=None):
        """After an install or update: what this station does with it."""
        meta = meta or self.registry.get_meta(app_name)
        unsuited = meta and self.not_for_here(meta)
        if unsuited:
            print(f"[tw] [!] {app_name} is marked {unsuited}; this station is {self.station_platform()}")
        own = self.station_hooks_dir()
        hooks = self._hook_files(app_name)
        if own is not None and hooks and not all((own / h.name).exists() for h in hooks):
            chosen = [a.strip() for a in self._rc_value('mobilize.hooks').split(',') if a.strip()]
            chosen = ', '.join(chosen + [app_name]) if app_name not in chosen else ', '.join(chosen)
            print(f"[tw] This station runs its own hook list ({_portable(str(own))}), so {app_name}'s "
                  f"hooks don't run here yet. To run them: mobilize hooks --set '{chosen}'")
        if hooks and own is None:
            print(f"[tw] Its hooks run on every station that runs ~/.task/hooks, once ~/.task syncs")

    def _claim(self, app_name):
        """After an install: the files it lists are its own now. An app that listed them too (an
        earlier install under another name) loses those lines, and goes when it has none left."""
        self.manifest = Manifest(self.paths.manifest_file)     # the installer wrote its lines
        for other, files in self.manifest.claim(app_name).items():
            print(f"[tw] {app_name} took over {len(files)} file(s) {other} listed")
            left = self.manifest.get_files(other)
            if not left:
                print(f"[tw] [+] Retired: {other} (nothing of its own left)")
            else:
                print(f"[tw] [!] {other} still lists {len(left)} file(s) of its own; "
                      f"tw -r {other} removes them")

    def remove(self, app_name):
        """Remove an application with its installer's remove; without an installer, delete the
        files the manifest lists. Either way, drop its manifest lines and repair includes.
        A file another app lists too is kept: put back if the installer removes it anyway."""
        if not self.manifest.is_installed(app_name):
            print(f"[tw] [!] Not installed: {app_name}")
            return False

        shared = [Path(f) for f in self.manifest.shared_files(app_name)]
        keep = {f: f.read_bytes() for f in shared if f.is_file() and not f.is_symlink()}
        links = {f: os.readlink(f) for f in shared if f.is_symlink()}
        modes = {f: f.stat().st_mode for f in keep}

        debug(f"AppManager.remove: Getting installer for {app_name}", 2)
        installer_path = self.registry.get_installer(app_name)
        if installer_path:
            try:
                ok = self._run_installer(installer_path, 'remove')
            finally:
                if not self.paths.is_dev_mode:
                    shutil.rmtree(installer_path.parent, ignore_errors=True)
                self._put_back(keep, links, modes)
            if not ok:
                print(f"[tw] [X] Removal failed: {app_name}")
                return False
        else:
            print(f"[tw] Installer not found, using manifest for removal")
            for file_path in self.manifest.get_files(app_name):
                path = Path(file_path)
                if path in shared:
                    continue
                if path.exists() or path.is_symlink():
                    path.unlink()
                    print(f"[tw]   Removed: {file_path}")
        if shared:
            print(f"[tw] Kept {len(shared)} file(s) another app lists too")

        self.manifest = Manifest(self.paths.manifest_file)     # the installer may have edited it
        self.manifest.remove_app(app_name)
        _repair_after_remove(self.paths, app_name)
        print(f"[tw] [+] Removed: {app_name}")
        return True
    
    @staticmethod
    def _put_back(keep, links, modes):
        """Restore shared files an installer's remove took (remove's keep/links)."""
        for f, data in keep.items():
            if not f.exists():
                f.parent.mkdir(parents=True, exist_ok=True)
                f.write_bytes(data)
                os.chmod(f, modes[f])
        for f, target in links.items():
            if not f.is_symlink() and not f.exists():
                os.symlink(target, f)

    def update(self, app_name):
        """Update an application safely using stage-then-install
        
        Flow:
          1. Download all new files to temp staging dir (preflight check)
          2. Verify checksums (if available)
          3. If staging fails -> old version stays completely intact
          4. If staging succeeds -> remove old, run real .install script
          5. If .install fails -> restore from staged backup
        
        The .install script remains the single source of truth for
        file placement, permissions, .taskrc, and manifest tracking.
        Python staging is purely a safety net / preflight download check.
        """
        if not self.manifest.is_installed(app_name):
            print(f"[tw] [!] Not installed: {app_name}")
            print(f"[tw] Use --install to install it")
            return False
        
        old_version = self.manifest.get_version(app_name)
        meta = self.registry.get_meta(app_name)
        if not meta:
            print(f"[tw] [X] Meta file not found for: {app_name}")
            return False
        
        new_version = meta.get('version', '?')
        
        if old_version == new_version:
            print(f"[tw] Already at v{new_version}")
            try:
                response = input("[tw] Reinstall anyway? [y/N]: ").strip().lower()
            except EOFError:
                response = 'n'
            if response != 'y':
                return True
        
        print(f"[tw] Updating {app_name}: v{old_version} -> v{new_version}")
        
        # Step 1: Preflight - download all new files to temp dir
        print(f"[tw] Preflight: staging new files...")
        staged = self._stage_downloads(app_name, meta)
        if not staged:
            print(f"[tw] [X] Preflight failed - v{old_version} is still installed")
            return False
        
        stage_dir = staged
        print(f"[tw] Preflight passed - all files downloaded and verified")
        
        # Step 2: Backup current installed files (from manifest)
        backup_dir = self._backup_files(app_name)
        
        # Also backup manifest entries for this app
        backup_manifest = [e.copy() for e in self.manifest.entries if e['app'] == app_name]
        
        # Step 3: Remove old version via installer. If that fails, stop: installing on top of a
        # half-removed version leaves two versions' files and manifest lines.
        print(f"[tw] Removing v{old_version}...")
        if not self.remove(app_name):
            print(f"[tw] [X] Removing v{old_version} failed; v{new_version} not installed")
            self._restore_files(backup_dir, backup_manifest)
            shutil.rmtree(stage_dir, ignore_errors=True)
            shutil.rmtree(backup_dir, ignore_errors=True)
            print(f"[tw] Put back v{old_version}'s files; its manifest entries were never removed")
            return False
        
        # Step 4: Install new version via real .install script
        print(f"[tw] Installing v{new_version}...")
        if self.install(app_name, stage_dir=stage_dir):
            # Success - clean up staging and backup
            shutil.rmtree(stage_dir, ignore_errors=True)
            shutil.rmtree(backup_dir, ignore_errors=True)
            print(f"[tw] [+] Updated {app_name}: v{old_version} -> v{new_version}")
            self._station_notes(app_name, meta)
            return True
        else:
            # Install failed - restore from backup
            print(f"[tw] [X] Install failed! Restoring v{old_version}...")
            restore_ok = self._restore_backup(app_name, backup_dir, backup_manifest)
            
            # Clean up staging dir
            shutil.rmtree(stage_dir, ignore_errors=True)
            
            if restore_ok:
                print(f"[tw] [+] Restored v{old_version}")
            else:
                print(f"[tw] [X] Restore failed! Backup preserved at: {backup_dir}")
            
            return False
    
    def _stage_downloads(self, app_name, meta):
        """Download all files to a temp staging directory as a preflight check.
        
        This does NOT install anything - it just verifies that all files
        can be downloaded and checksums match before we touch the old version.
        The installer is staged beside them, so its SCRIPT_DIR finds them.
        
        Returns stage_dir Path on success, None on failure.
        """
        base_url = meta.get_base_url().rstrip('/')
        if not base_url:
            print(f"[tw] [X] No base_url in meta for {app_name}")
            return None
        files = meta.get_files()
        if not files:
            print(f"[tw] [X] No files listed in meta for {app_name}")
            return None
        checksums = meta.get_checksums()
        
        stage_dir = Path(tempfile.mkdtemp(prefix=f'tw-stage-{app_name}-'))
        debug(f"Staging directory: {stage_dir}", 2)

        def fail(message):
            print(f"[tw] [X] {message}")
            shutil.rmtree(stage_dir, ignore_errors=True)
            return None

        for i, (filename, file_type) in enumerate(files):
            print(f"[tw]   Downloading: {filename}")
            data = _fetch(f"{base_url}/{filename}")
            if data is None:
                return fail(f"Download failed: {filename}")
            staged_path = stage_dir / filename
            staged_path.parent.mkdir(parents=True, exist_ok=True)
            staged_path.write_bytes(data)
            # Verify checksum if available (skip docs - git may alter them)
            if file_type != 'doc' and i < len(checksums) and checksums[i]:
                actual = hashlib.sha256(data).hexdigest()
                if actual != checksums[i]:
                    debug(f"Expected: {checksums[i]}  Got: {actual}", 1)
                    return fail(f"Checksum mismatch: {filename}")
                debug(f"Checksum verified: {filename}", 2)
        
        print(f"[tw] [+] All {len(files)} files staged and verified")
        if self.paths.is_dev_mode:
            local_installer = self.paths.local_installers / f"{app_name}.install"
            if local_installer.exists():
                shutil.copy2(local_installer, stage_dir / f"{app_name}.install")
        elif not self.registry.get_installer(app_name, dest_dir=stage_dir):
            debug(f"Could not stage installer for {app_name}", 1)    # install() says so
        return stage_dir
    
    @staticmethod
    def _backup_path(backup_dir, original):
        """Where a file's backup goes: its whole path under backup_dir, so two files with one name
        (two README.md) never share a backup."""
        return Path(backup_dir) / Path(original).resolve().relative_to('/')

    def _backup_files(self, app_name):
        """Copy the app's installed files (as the manifest lists them) to a new temp dir."""
        backup_dir = Path(tempfile.mkdtemp(prefix=f'tw-backup-{app_name}-'))
        debug(f"Backup directory: {backup_dir}", 2)
        for file_path in self.manifest.get_files(app_name):
            if Path(file_path).exists():
                dst = self._backup_path(backup_dir, file_path)
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(file_path, dst)
                debug(f"Backed up: {file_path} -> {dst}", 2)
        return backup_dir

    def _restore_files(self, backup_dir, backup_manifest):
        """Copy backed-up files back to their places (the manifest's paths); copy2 keeps modes."""
        for entry in backup_manifest:
            original_path = Path(entry['file'])
            backup_file = self._backup_path(backup_dir, original_path)
            if backup_file.exists():
                original_path.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(backup_file, original_path)
                debug(f"Restored: {backup_file} -> {original_path}", 2)

    def _restore_backup(self, app_name, backup_dir, backup_manifest):
        """Restore files from backup after a failed update.
        
        Copies backed-up files back to their original locations
        and restores manifest entries.
        
        Returns True on success, False on failure.
        """
        try:
            self._restore_files(backup_dir, backup_manifest)

            # Restore manifest entries: exactly the backup's for this app. Re-read the file first,
            # since the installers append to it directly; drop whatever the app has there now (a
            # failed install's lines, or a remove that left them) so nothing is listed twice.
            self.manifest = Manifest(self.paths.manifest_file)
            self.manifest.entries = [e for e in self.manifest.entries if e['app'] != app_name]
            for entry in backup_manifest:
                self.manifest.entries.append(entry)
            self.manifest._save()
            
            # Clean up backup dir on success
            shutil.rmtree(backup_dir, ignore_errors=True)
            return True
        
        except Exception as e:
            print(f"[tw] [X] Restore error: {e}")
            return False
    
    def list_installed(self, tag_filter=None):
        """List all installed and available applications with optional tag filtering"""
        installed = self.manifest.apps()
        
        # Get all available apps from registry
        available = self.registry.list_apps()
        
        # Build combined list with status
        all_apps = {}
        for app, meta in self.registry.get_metas(available).items():
            if meta:
                version = meta.data.get('version', '?')
                tags = meta.get_tags()
                is_installed = app in installed
                all_apps[app] = {
                    'version': version,
                    'installed_version': installed.get(app, None),
                    'is_installed': is_installed,
                    'tags': tags,
                    'not_here': self.not_here(app) if is_installed else None,
                    'not_for_here': self.not_for_here(meta),
                }
        
        # Apply tag filter if provided
        if tag_filter and tag_filter.has_filters():
            filtered_apps = {}
            for app, info in all_apps.items():
                if tag_filter.matches(info['tags']):
                    filtered_apps[app] = info

            if not filtered_apps:
                print(f"[tw] No applications match filter: {tag_filter}")
                return

            all_apps = filtered_apps

        if not all_apps:
            print("[tw] No applications in registry")
            return

        CYAN  = "\033[36m"
        RESET = "\033[0m"

        n_installed = 0
        n_updates   = 0
        n_not_here  = 0

        # Display apps with status indicators
        for app, info in sorted(all_apps.items()):
            inst_ver = info['installed_version']
            reg_ver  = info['version']
            update_avail = info['is_installed'] and inst_ver and inst_ver != reg_ver

            if update_avail:
                status      = "[↑] "
                version_str = f"v{inst_ver}→{reg_ver}"
                n_installed += 1
                n_updates   += 1
            elif info['is_installed'] and info['not_here']:
                status      = "[~] "
                version_str = f"v{inst_ver}"
                n_installed += 1
                n_not_here  += 1
            elif info['is_installed']:
                status      = "[*] "
                version_str = f"v{inst_ver}"
                n_installed += 1
            else:
                status      = "[ ] "
                version_str = f"v{reg_ver}"

            tags_str = f" [{', '.join(info['tags'])}]" if info['tags'] else ""
            line = f"[tw] {status}{app} ({version_str}){tags_str}"
            notes = [n for n in (info['not_here'] if info['is_installed'] else None,
                                 info['not_for_here']) if n]
            if notes:
                line += f"  ({'; '.join(notes)})"

            if update_avail:
                print(f"{CYAN}{line}{RESET}")
            else:
                print(line)

        # Installed, but no longer (or never) in the registry: an old name, an abandoned attempt
        unlisted = [] if tag_filter and tag_filter.has_filters() else \
            [a for a in installed if a not in available]
        for app in sorted(unlisted):
            print(f"[tw] [?] {app} (v{installed[app]}) not in the registry; tw -r {app} retires it")

        # Footer
        total = len(all_apps)
        filter_str = f" (filtered by {tag_filter})" if tag_filter and tag_filter.has_filters() else ""
        footer = f"[tw] ({total}) Available applications{filter_str}"
        if n_installed:
            footer += f"  ·  {n_installed} installed"
        if n_updates:
            footer += f"  ·  {CYAN}{n_updates} update(s) available{RESET}"
        print(f"\n{footer}")
        legend = f"[tw] Legend: [*] installed  [↑] {CYAN}update available{RESET}  [ ] not installed"
        if n_not_here:
            legend += "  [~] installed, not at work on this station"
        print(legend + ("  [?] not in registry" if unlisted else ""))
        station = self._rc_value('gittw.device')
        own = self.station_hooks_dir()
        if station or own is not None:
            where = f"its own hook list, {_portable(str(own))}" if own is not None else "~/.task/hooks"
            kind = f" ({self.station_platform()})" if self.station_platform() else ""
            print(f"[tw] Station {station or '(unnamed)'}{kind} runs {where}; ~/.task, and what's "
                  f"installed in it, is shared with the other stations")
    
    def list_tags(self, app_names=None):
        """List all available tags from registry, optionally filtered by app names
        
        Args:
            app_names: List of app names to filter by, or None for all apps
        """
        tag_counts = {}
        
        apps = [a for a in self.registry.list_apps() if not app_names or a in app_names]
        for meta in self.registry.get_metas(apps).values():
            for tag in meta.get_tags():
                tag_counts[tag] = tag_counts.get(tag, 0) + 1
        
        if not tag_counts:
            if app_names:
                print(f"[tw] No tags found for: {', '.join(app_names)}")
            else:
                print("[tw] No tags found in registry")
            return
        
        # Display tags
        if app_names:
            print(f"[tw] Tags for {', '.join(app_names)}:")
        else:
            print("[tw] Available tags:")
        
        for tag, count in sorted(tag_counts.items()):
            print(f"[tw]   {tag} ({count} app{'s' if count != 1 else ''})")
    
    def show_info_all(self, tag_filter=None):
        """Show info for all available applications (installed or not)
        
        Args:
            tag_filter: Optional TagFilter to filter apps by tags
        """
        debug(f"show_info_all called, dev_mode={self.paths.is_dev_mode}", 2)
        
        # Get all apps from registry
        all_apps = []
        apps = self.registry.list_apps()
        debug(f"Found {len(apps)} apps in registry", 2)
        self.registry.get_metas(apps)       # fetch them all at once; the loops below hit the cache
        
        for app_name in apps:
            debug(f"Processing {app_name}", 3)
            
            # Apply tag filter if provided
            if tag_filter and tag_filter.has_filters():
                meta = self.registry.get_meta(app_name)
                if not meta:
                    continue
                tags = meta.get_tags()
                debug(f"App {app_name} has tags: {tags}", 3)
                if not tag_filter.matches(tags):
                    debug(f"App {app_name} filtered out by tag filter", 3)
                    continue
            
            all_apps.append(app_name)
        
        debug(f"Final app list: {all_apps}", 2)
        
        if not all_apps:
            if tag_filter and tag_filter.has_filters():
                print(f"[tw] No applications match filter: {tag_filter}")
            else:
                print(f"[tw] No applications found in registry")
            return False
        
        # Show info for each app
        if tag_filter and tag_filter.has_filters():
            print(f"[tw] Applications matching {tag_filter}:\n")
        else:
            print(f"[tw] All available applications:\n")
        
        for i, app_name in enumerate(sorted(all_apps)):
            if i > 0:
                print()  # Blank line between apps
            self.show_info(app_name)
        
        return True

    
    def show_info(self, app_name):
        """Show information about an application"""
        meta = self.registry.get_meta(app_name)
        
        if not meta:
            print(f"[tw] [X] Application not found: {app_name}")
            return False
        
        print(f"[tw] Application: {app_name}")
        print(f"[tw]   Name: {meta.get('name', 'N/A')}")
        print(f"[tw]   Version: {meta.get('version', 'N/A')}")
        print(f"[tw]   Type: {meta.get('type', 'N/A')}")
        print(f"[tw]   Description: {meta.get('description', 'N/A')}")
        print(f"[tw]   Repository: {meta.get('repo', 'N/A')}")
        print(f"[tw]   Base URL: {meta.get('base_url', 'N/A')}")
        
        # Show files
        files = meta.get_files()
        if files:
            print(f"[tw]   Files ({len(files)}):")
            for filename, file_type in files:
                print(f"[tw]     {filename} ({file_type})")
        
        # Show installation status
        if self.manifest.is_installed(app_name):
            installed_version = self.manifest.get_version(app_name)
            print(f"[tw]   Status: Installed (v{installed_version})")
            
            # Show README location if it exists
            readme_path = self.paths.docs_dir / f"{app_name}_README.md"
            if readme_path.exists():
                print(f"[tw]   README: {readme_path}")
        else:
            print(f"[tw]   Status: Not installed")
        
        return True
    
    def verify(self, app_name):
        """Verify checksums of installed files"""
        if not self.manifest.is_installed(app_name):
            print(f"[tw] [!] Not installed: {app_name}")
            return False
        
        meta = self.registry.get_meta(app_name)
        if not meta:
            print(f"[tw] [!] Meta file not found for: {app_name}")
            return False
        checksums = meta.get_checksums()
        files = meta.get_files()
        
        if not checksums:
            print(f"[tw] [i] No checksums available for {app_name}")
            return True
        
        print(f"[tw] Verifying {app_name}...")
        installed, current = self.manifest.get_version(app_name), meta.get('version')
        if current and installed != current:
            print(f"[tw] [i] v{installed} is installed; these checksums are v{current}'s (tw -u {app_name})")
        all_valid = True
        modified = 0
        # Where the installer put each file, as it recorded it; the file type is only a guess
        recorded = {Path(f).name: Path(f) for f in self.manifest.get_files(app_name)}
        
        for i, (filename, file_type) in enumerate(files):
            if i >= len(checksums):
                break
            
            expected_checksum = checksums[i]
            if not expected_checksum:
                continue
            
            # Skip docs - git/download may alter line endings
            if file_type == 'doc':
                debug(f"Skipping checksum for doc: {filename}", 2)
                continue
            
            file_path = (recorded.get(filename) or meta.get_dest(filename, self.paths.task_dir)
                         or self._get_target_dir(file_type) / filename)
            
            if not file_path.exists():
                print(f"[tw] [!] File not found: {file_path}")
                all_valid = False
                continue
            
            # Calculate checksum
            actual_checksum = self._calculate_checksum(file_path)
            
            if actual_checksum == expected_checksum:
                print(f"[tw] [ok] {filename}")
            elif file_type == 'config':
                # Configs are yours and the app's to change (CONVENTIONS: apps write settings)
                print(f"[tw] [~] {filename} (modified)")
                modified += 1
            else:
                print(f"[tw] [!] {filename} (checksum mismatch)")
                all_valid = False
        
        if all_valid:
            note = f" ({modified} config file{'s' if modified != 1 else ''} modified)" if modified else ""
            print(f"[tw] [ok] All files verified{note}")
        else:
            print(f"[tw] [!] Verification failed")
        
        return all_valid
    
    def _get_target_dir(self, file_type):
        """Get target directory for a file type"""
        type_map = {
            'hook': self.paths.hooks_dir,
            'hooks': self.paths.hooks_dir,
            'script': self.paths.scripts_dir,
            'scripts': self.paths.scripts_dir,
            'config': self.paths.config_dir,
            'doc': self.paths.docs_dir,
            'systemd': self.paths.home / '.config' / 'systemd' / 'user',
        }
        return type_map.get(file_type, self.paths.task_dir)
    
    def _calculate_checksum(self, file_path):
        """Calculate SHA256 checksum of a file"""
        sha256_hash = hashlib.sha256()
        with open(file_path, "rb") as f:
            for byte_block in iter(lambda: f.read(4096), b""):
                sha256_hash.update(byte_block)
        return sha256_hash.hexdigest()

class TaskShell:
    """Interactive shell for Taskwarrior with persistent modifiers
    
    Integrated into tw wrapper - uses "tw" as shell name instead of "task"
    """
    
    def __init__(self, initial_head=None, initial_prefix=None):
        self.head = initial_head if initial_head else []
        self.prefix_stack = initial_prefix if initial_prefix else []
        self.templates = {
            "meeting": ["proj:meetings", "+work", "pri:M"],
            "bug": ["proj:bugs", "+work", "pri:H"],
        }
        self._init_history()
    
    def _init_history(self):
        """Initialize readline history"""
        try:
            readline.read_history_file(SHELL_HISTFILE)
        except FileNotFoundError:
            pass
    
    def _save_history(self):
        """Save readline history"""
        readline.write_history_file(SHELL_HISTFILE)
    
    def _format_prompt(self):
        """Build prompt showing current state"""
        if self.head:
            parts = [SHELL_NAME] + self.head + self.prefix_stack
        else:
            if self.prefix_stack:
                parts = [SHELL_NAME] + self.prefix_stack
            else:
                parts = [SHELL_NAME]
        return " ".join(parts) + "> "
    
    def _run_task(self, args):
        """Execute task command with full passthrough of stdout/stderr"""
        run_task(["rc.context=none"] + args)
    
    def _get_context(self, name):
        """A context's read filter as one parenthesised group, for the modifier stack; [] if it
        isn't defined. Reads 2.6.2's context.<name>.read (else the older context.<name>) and
        changes nothing: the shell runs with rc.context=none, so the stack is the context."""
        text = Cmx().filter(name)
        if not text:
            return []
        try:
            return ['('] + shlex.split(text) + [')']
        except ValueError:
            return ['('] + text.split() + [')']
    
    def _show_help(self, detailed=False):
        """Show shell help"""
        if detailed:
            show_help_topic('shell')
        else:
            # Show quick reference
            print("""
Commands:
  :head <args...>       set command head (e.g., :head add, :head modify)
  :head                 clear command head (return to base prompt)
  :push <mods...>       push persistent modifiers onto stack
  :pop                  pop last modifier from stack
  :clear                clear all modifiers from stack
  :context <n>       apply task context filters to stack
  :tpl <n>           apply a template to stack
  :show                 show current HEAD and PREFIX_STACK state
  :reset                reset both head and modifiers to empty
  :help                 show this quick reference
  :help shell           show detailed shell documentation
  :q | :quit | :exit    exit shell

Examples:
  :push +work proj:meetings
  :head add
  Schedule the standup
  # Runs: task add +work proj:meetings Schedule the standup

  :head
  list
  # Runs: task +work proj:meetings list
  
  (press Enter on empty line)
  # Runs: task +work proj:meetings (default report)
""".strip())
    
    def _handle_meta_command(self, cmd):
        """Handle meta-commands (commands starting with :)
        
        Returns True if shell should continue, False if it should exit
        """
        if not cmd:
            return True
        
        if cmd[0] in ("q", "quit", "exit"):
            return False
        
        elif cmd[0] == "help":
            # :help shell shows detailed help, :help shows quick reference
            detailed = len(cmd) > 1 and cmd[1] == "shell"
            self._show_help(detailed=detailed)
        
        elif cmd[0] == "head":
            # :head with no args clears HEAD to []
            self.head = cmd[1:] if len(cmd) > 1 else []
        
        elif cmd[0] == "push":
            self.prefix_stack.extend(cmd[1:])
        
        elif cmd[0] == "pop":
            if self.prefix_stack:
                self.prefix_stack.pop()
            else:
                print("PREFIX_STACK is empty")
        
        elif cmd[0] == "clear":
            self.prefix_stack.clear()
        
        elif cmd[0] == "reset":
            self.head = []
            self.prefix_stack.clear()
        
        elif cmd[0] == "show":
            print("HEAD:", self.head if self.head else "(empty)")
            print("PREFIX_STACK:", self.prefix_stack if self.prefix_stack else "(empty)")
        
        elif cmd[0] == "context":
            if len(cmd) > 1:
                context_filters = self._get_context(cmd[1])
                if context_filters:
                    self.prefix_stack.extend(context_filters)
                else:
                    print(f"Context '{cmd[1]}' isn't defined")
            else:
                print("Usage: :context <n>")
        
        elif cmd[0] == "tpl":
            if len(cmd) > 1:
                template = self.templates.get(cmd[1])
                if template:
                    self.prefix_stack.extend(template)
                else:
                    print(f"Unknown template: {cmd[1]}")
                    print(f"Available templates: {', '.join(self.templates.keys())}")
            else:
                print("Usage: :tpl <n>")
                print(f"Available templates: {', '.join(self.templates.keys())}")
        
        else:
            print(f"Unknown command: {cmd[0]}")
            print("Type :help for available commands")
        
        return True
    
    def _shell(self, cmd):
        """Run a shell command (`!cmd`, `exec cmd`) and remember it for `!!`."""
        self.last_shell_cmd = cmd
        subprocess.run(cmd, shell=True, check=False)

    def handle_line(self, line):
        """One input line. Returns False when the shell should exit."""
        line = line.strip()

        # Empty input: run default report with current state (bare `task` if there's none)
        if not line:
            self._run_task(self.head + self.prefix_stack)
            return True

        # Shell commands: exec cmd, !cmd, and !! (the last of those again; never a task line)
        if line.startswith('exec '):
            if line[5:].strip():
                self._shell(line[5:].strip())
            return True
        if line == '!!':
            last = getattr(self, 'last_shell_cmd', None)
            if last:
                print(f"[tw-shell] Repeating: {last}")
                self._shell(last)
            else:
                print("[tw-shell] No previous shell command to repeat")
            return True
        if line.startswith('!'):
            if line[1:].strip():
                self._shell(line[1:].strip())
            return True

        # Meta-commands
        if line.startswith(":"):
            try:
                cmd = shlex.split(line[1:])
            except ValueError as e:
                print(f"[tw-shell] {e}: {line}")
                return True
            return self._handle_meta_command(cmd)

        # A task command: HEAD + PREFIX_STACK, then the line. Quotes group words as in a shell; a
        # line they can't parse (an apostrophe: "don't forget milk") is split on spaces instead.
        try:
            words = shlex.split(line)
        except ValueError:
            words = line.split()
        self._run_task(self.head + self.prefix_stack + words)
        return True

    def run(self):
        """Run the interactive shell"""
        try:
            while True:
                if not self.handle_line(input(self._format_prompt())):
                    break
        except (EOFError, KeyboardInterrupt):
            print()
        finally:
            self._save_history()

