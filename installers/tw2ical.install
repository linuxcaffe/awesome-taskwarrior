#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# tw2ical - Installer Script
# Version: 0.2.0
# Generated by make-awesome.py
# ============================================================================

VERSION="0.2.0"
APPNAME="tw2ical"
BASE_URL="https://raw.githubusercontent.com/linuxcaffe/tw-ical-hook/main"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

tw_msg() { echo -e "${BLUE}[tw]${NC} $*"; }
tw_success() { echo -e "${GREEN}[tw] [OK]${NC} $*"; }
tw_error() { echo -e "${RED}[tw] [FAIL]${NC} $*" >&2; }

# Debug support
DEBUG_LEVEL="${TW_DEBUG:-0}"
debug_msg() {
    local msg="$1"
    local level="${2:-1}"
    if [[ $DEBUG_LEVEL -ge $level ]]; then
        echo -e "${BLUE}[DEBUG-$level]${NC} $msg" >&2
    fi
}

debug_msg "Starting installer with DEBUG_LEVEL=$DEBUG_LEVEL" 1

# Directories
HOME="${HOME:-$(eval echo ~$USER)}"
TASKRC="${TASKRC:-${HOME}/.taskrc}"
TASK_DIR="${TW_TASK_DIR:-${HOME}/.task}"
HOOKS_DIR="${TASK_DIR}/hooks"
SCRIPTS_DIR="${TASK_DIR}/scripts"
CONFIG_DIR="${TASK_DIR}/config"
DOCS_DIR="${TASK_DIR}/docs"
MAN_DIR="${DOCS_DIR}/man"

# ============================================================================
# Installation Function
# ============================================================================

install() {
    tw_msg "Installing tw2ical v$VERSION..."
    debug_msg "Starting installation" 1

    # Create directories
    tw_msg "Creating directories..."
    mkdir -p "$HOOKS_DIR" "$SCRIPTS_DIR" "$CONFIG_DIR" "$DOCS_DIR"
    debug_msg "Directories created" 2

    tw_msg "Downloading files..."
    debug_msg "Using BASE_URL: $BASE_URL" 2

    debug_msg "Downloading hook: on-add_tw-ical.py" 2
    curl -fsSL "$BASE_URL/on-add_tw-ical.py" -o "$HOOKS_DIR/on-add_tw-ical.py" || {
        tw_error "Failed to download on-add_tw-ical.py"
        debug_msg "Download failed: on-add_tw-ical.py" 1
        return 1
    }
    chmod +x "$HOOKS_DIR/on-add_tw-ical.py"
    debug_msg "Installed hook: $HOOKS_DIR/on-add_tw-ical.py" 2

    debug_msg "Downloading hook: on-modify_tw-ical.py" 2
    curl -fsSL "$BASE_URL/on-modify_tw-ical.py" -o "$HOOKS_DIR/on-modify_tw-ical.py" || {
        tw_error "Failed to download on-modify_tw-ical.py"
        debug_msg "Download failed: on-modify_tw-ical.py" 1
        return 1
    }
    chmod +x "$HOOKS_DIR/on-modify_tw-ical.py"
    debug_msg "Installed hook: $HOOKS_DIR/on-modify_tw-ical.py" 2

    debug_msg "Downloading script: tw_ical_lib.py" 2
    curl -fsSL "$BASE_URL/tw_ical_lib.py" -o "$SCRIPTS_DIR/tw_ical_lib.py" || {
        tw_error "Failed to download tw_ical_lib.py"
        debug_msg "Download failed: tw_ical_lib.py" 1
        return 1
    }
    chmod +x "$SCRIPTS_DIR/tw_ical_lib.py"
    debug_msg "Installed script: $SCRIPTS_DIR/tw_ical_lib.py" 2

    debug_msg "Downloading script: tw-ical-export.py" 2
    curl -fsSL "$BASE_URL/tw-ical-export.py" -o "$SCRIPTS_DIR/tw-ical-export.py" || {
        tw_error "Failed to download tw-ical-export.py"
        debug_msg "Download failed: tw-ical-export.py" 1
        return 1
    }
    chmod +x "$SCRIPTS_DIR/tw-ical-export.py"
    debug_msg "Installed script: $SCRIPTS_DIR/tw-ical-export.py" 2

    debug_msg "Downloading config: tw-ical.rc" 2
    curl -fsSL "$BASE_URL/tw-ical.rc" -o "$CONFIG_DIR/tw-ical.rc.new" || {
        rm -f "$CONFIG_DIR/tw-ical.rc.new"
        tw_error "Failed to download tw-ical.rc"
        debug_msg "Download failed: tw-ical.rc" 1
        return 1
    }
    if [[ ! -f "$CONFIG_DIR/tw-ical.rc" ]]; then
        mv "$CONFIG_DIR/tw-ical.rc.new" "$CONFIG_DIR/tw-ical.rc"
        debug_msg "Installed config: $CONFIG_DIR/tw-ical.rc" 2
    elif cmp -s "$CONFIG_DIR/tw-ical.rc" "$CONFIG_DIR/tw-ical.rc.new"; then
        rm -f "$CONFIG_DIR/tw-ical.rc.new"
    else
        tw_msg "Kept your tw-ical.rc; the new default is tw-ical.rc.new"
    fi

    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    # tw-ical.rc is discrete: no include (drop one an older version added)
    for rcfile in "$INCLUDED_RC" "$TASKRC"; do
        if grep -qE "^[[:space:]]*#?[[:space:]]*include[[:space:]].*/tw-ical\.rc([[:space:]]|$)" "$rcfile" 2>/dev/null; then
            sed -i.bak -E "\%^[[:space:]]*#?[[:space:]]*include[[:space:]].*/tw-ical\.rc([[:space:]]|$)%d" "$rcfile"
            tw_msg "Took tw-ical.rc out of the include chain: tw2ical reads its own settings"
        fi
    done

    tw_msg "Downloading documentation..."
    curl -fsSL "$BASE_URL/README.md" -o "$DOCS_DIR/tw2ical_README.md" 2>/dev/null || true
    debug_msg "Downloaded doc: $DOCS_DIR/tw2ical_README.md" 2

    # Track in manifest
    debug_msg "Writing to manifest" 2
    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$(dirname "$MANIFEST_FILE")"

    echo "$APPNAME|$VERSION|$HOOKS_DIR/on-add_tw-ical.py||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $HOOKS_DIR/on-add_tw-ical.py" 3
    echo "$APPNAME|$VERSION|$HOOKS_DIR/on-modify_tw-ical.py||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $HOOKS_DIR/on-modify_tw-ical.py" 3
    echo "$APPNAME|$VERSION|$SCRIPTS_DIR/tw_ical_lib.py||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $SCRIPTS_DIR/tw_ical_lib.py" 3
    echo "$APPNAME|$VERSION|$SCRIPTS_DIR/tw-ical-export.py||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $SCRIPTS_DIR/tw-ical-export.py" 3
    echo "$APPNAME|$VERSION|$CONFIG_DIR/tw-ical.rc||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $CONFIG_DIR/tw-ical.rc" 3
    echo "$APPNAME|$VERSION|$DOCS_DIR/tw2ical_README.md||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $DOCS_DIR/tw2ical_README.md" 3

    debug_msg "Installation complete" 1
    tw_success "Installed tw2ical v$VERSION"
    echo ""
    tw_msg "Documentation: $DOCS_DIR/tw2ical_README.md"
    echo ""

    return 0
}

# ============================================================================
# Removal Function
# ============================================================================

remove() {
    tw_msg "Removing tw2ical..."
    debug_msg "Starting removal" 1

    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    if [ ! -f "$MANIFEST_FILE" ]; then
        tw_error "Manifest file not found"
        return 1
    fi

    # Remove files based on manifest
    grep "^$APPNAME|" "$MANIFEST_FILE" | cut -d"|" -f3 | while read -r file; do
        if [ -f "$file" ] || [ -L "$file" ]; then   # -L: a link, even dangling
            rm "$file"
            debug_msg "Removed: $file" 2
            tw_msg "Removed: $(basename $file)"
        fi
    done

    # Remove from manifest
    sed -i.bak "/^$APPNAME|/d" "$MANIFEST_FILE"
    debug_msg "Removed from manifest" 2

    # Remove config includes from included.rc and .taskrc
    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    for rcfile in "$INCLUDED_RC" "$TASKRC"; do
        if grep -qE "^[[:space:]]*#?[[:space:]]*include[[:space:]].*/tw-ical\.rc([[:space:]]|$)" "$rcfile" 2>/dev/null; then
            sed -i.bak -E "\%^[[:space:]]*#?[[:space:]]*include[[:space:]].*/tw-ical\.rc([[:space:]]|$)%d" "$rcfile"
            tw_msg "Removed include of tw-ical.rc from $(basename "$rcfile")"
        fi
    done

    tw_success "Removed tw2ical"
    return 0
}

# ============================================================================
# Main
# ============================================================================

case "${1:-install}" in
    install)
        install
        ;;
    remove|uninstall)
        remove
        ;;
    *)
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
