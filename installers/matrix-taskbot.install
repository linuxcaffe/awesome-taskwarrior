#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# matrix-taskbot - Installer Script
# Version: 0.2.0
# Generated by make-awesome.py
# ============================================================================

VERSION="0.2.0"
APPNAME="matrix-taskbot"
BASE_URL="https://raw.githubusercontent.com/linuxcaffe/tw-matrix-bot/main"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

tw_msg() { echo -e "${BLUE}[tw]${NC} $*"; }
tw_success() { echo -e "${GREEN}[tw] [OK]${NC} $*"; }
tw_error() { echo -e "${RED}[tw] [FAIL]${NC} $*" >&2; }

# Debug support
DEBUG_LEVEL="${TW_DEBUG:-0}"
debug_msg() {
    local msg="$1"
    local level="${2:-1}"
    if [[ $DEBUG_LEVEL -ge $level ]]; then
        echo -e "${BLUE}[DEBUG-$level]${NC} $msg" >&2
    fi
}

debug_msg "Starting installer with DEBUG_LEVEL=$DEBUG_LEVEL" 1

# Directories
HOME="${HOME:-$(eval echo ~$USER)}"
TASKRC="${TASKRC:-${HOME}/.taskrc}"
TASK_DIR="${TW_TASK_DIR:-${HOME}/.task}"
HOOKS_DIR="${TASK_DIR}/hooks"
SCRIPTS_DIR="${TASK_DIR}/scripts"
CONFIG_DIR="${TASK_DIR}/config"
DOCS_DIR="${TASK_DIR}/docs"
MAN_DIR="${DOCS_DIR}/man"

# ============================================================================
# Installation Function
# ============================================================================

install() {
    tw_msg "Installing matrix-taskbot v$VERSION..."
    debug_msg "Starting installation" 1

    # Create directories
    tw_msg "Creating directories..."
    mkdir -p "$HOOKS_DIR" "$SCRIPTS_DIR" "$CONFIG_DIR" "$DOCS_DIR"
    debug_msg "Directories created" 2

    tw_msg "Downloading files..."
    debug_msg "Using BASE_URL: $BASE_URL" 2

    debug_msg "Downloading script: matrix-taskbot.py" 2
    curl -fsSL "$BASE_URL/matrix-taskbot.py" -o "$SCRIPTS_DIR/matrix-taskbot.py" || {
        tw_error "Failed to download matrix-taskbot.py"
        debug_msg "Download failed: matrix-taskbot.py" 1
        return 1
    }
    chmod +x "$SCRIPTS_DIR/matrix-taskbot.py"
    debug_msg "Installed script: $SCRIPTS_DIR/matrix-taskbot.py" 2

    debug_msg "Downloading config: matrix-taskbot.rc" 2
    curl -fsSL "$BASE_URL/matrix-taskbot.rc" -o "$CONFIG_DIR/matrix-taskbot.rc.new" || {
        rm -f "$CONFIG_DIR/matrix-taskbot.rc.new"
        tw_error "Failed to download matrix-taskbot.rc"
        debug_msg "Download failed: matrix-taskbot.rc" 1
        return 1
    }
    if [[ ! -f "$CONFIG_DIR/matrix-taskbot.rc" ]]; then
        mv "$CONFIG_DIR/matrix-taskbot.rc.new" "$CONFIG_DIR/matrix-taskbot.rc"
        debug_msg "Installed config: $CONFIG_DIR/matrix-taskbot.rc" 2
    elif cmp -s "$CONFIG_DIR/matrix-taskbot.rc" "$CONFIG_DIR/matrix-taskbot.rc.new"; then
        rm -f "$CONFIG_DIR/matrix-taskbot.rc.new"
    else
        tw_msg "Kept your matrix-taskbot.rc; the new default is matrix-taskbot.rc.new"
    fi

    # Add config include to included.rc (if present) or .taskrc
    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    if [ "$TASK_DIR" = "$HOME/.task" ]; then
        INC_PATH="~/.task/config/matrix-taskbot.rc"
    else
        INC_PATH="${TASK_DIR}/config/matrix-taskbot.rc"
    fi
    if grep -qE "^[[:space:]]*include[[:space:]].*matrix-taskbot.rc" "$TASKRC" "$INCLUDED_RC" 2>/dev/null; then
        tw_msg "Config already included"
        debug_msg "Config already present: matrix-taskbot.rc" 2
    elif grep -qE "^[[:space:]]*#[[:space:]]*include[[:space:]].*matrix-taskbot.rc" "$INCLUDED_RC" 2>/dev/null; then
        sed -i.bak -E "s|^[[:space:]]*#[[:space:]]*(include[[:space:]].*matrix-taskbot.rc)[[:space:]]*(#.*)?$|\1|" "$INCLUDED_RC"
        tw_msg "Re-enabled config include in included.rc"
    elif [ -f "$INCLUDED_RC" ]; then
        echo "include $INC_PATH" >> "$INCLUDED_RC"
        tw_msg "Added config include to included.rc"
        debug_msg "Added to included.rc: include $INC_PATH" 2
    else
        echo "include $INC_PATH" >> "$TASKRC"
        tw_msg "Added config include to .taskrc"
        debug_msg "Added to .taskrc: include $INC_PATH" 2
    fi

    tw_msg "Downloading documentation..."
    curl -fsSL "$BASE_URL/README.md" -o "$DOCS_DIR/matrix-taskbot_README.md" 2>/dev/null || true
    debug_msg "Downloaded doc: $DOCS_DIR/matrix-taskbot_README.md" 2

    # Track in manifest
    debug_msg "Writing to manifest" 2
    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$(dirname "$MANIFEST_FILE")"

    echo "$APPNAME|$VERSION|$SCRIPTS_DIR/matrix-taskbot.py||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $SCRIPTS_DIR/matrix-taskbot.py" 3
    echo "$APPNAME|$VERSION|$CONFIG_DIR/matrix-taskbot.rc||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $CONFIG_DIR/matrix-taskbot.rc" 3
    echo "$APPNAME|$VERSION|$DOCS_DIR/matrix-taskbot_README.md||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $DOCS_DIR/matrix-taskbot_README.md" 3

    debug_msg "Installation complete" 1
    tw_success "Installed matrix-taskbot v$VERSION"
    echo ""
    tw_msg "Documentation: $DOCS_DIR/matrix-taskbot_README.md"
    echo ""

    return 0
}

# ============================================================================
# Removal Function
# ============================================================================

remove() {
    tw_msg "Removing matrix-taskbot..."
    debug_msg "Starting removal" 1

    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    if [ ! -f "$MANIFEST_FILE" ]; then
        tw_error "Manifest file not found"
        return 1
    fi

    # Remove files based on manifest
    grep "^$APPNAME|" "$MANIFEST_FILE" | cut -d"|" -f3 | while read -r file; do
        if [ -f "$file" ] || [ -L "$file" ]; then   # -L: a link, even dangling
            rm "$file"
            debug_msg "Removed: $file" 2
            tw_msg "Removed: $(basename $file)"
        fi
    done

    # Remove from manifest
    sed -i.bak "/^$APPNAME|/d" "$MANIFEST_FILE"
    debug_msg "Removed from manifest" 2

    # Remove config include from included.rc or .taskrc
    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    if grep -q "matrix-taskbot.rc" "$INCLUDED_RC" 2>/dev/null; then
        sed -i.bak "/matrix-taskbot.rc/d" "$INCLUDED_RC"
        tw_msg "Removed config from included.rc"
        debug_msg "Removed from included.rc: matrix-taskbot.rc" 2
    elif grep -q "matrix-taskbot.rc" "$TASKRC" 2>/dev/null; then
        sed -i.bak "/matrix-taskbot.rc/d" "$TASKRC"
        tw_msg "Removed config from .taskrc"
        debug_msg "Removed from .taskrc: matrix-taskbot.rc" 2
    fi

    tw_success "Removed matrix-taskbot"
    return 0
}

# ============================================================================
# Main
# ============================================================================

case "${1:-install}" in
    install)
        install
        ;;
    remove|uninstall)
        remove
        ;;
    *)
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
